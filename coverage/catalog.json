      "scope": [
        "Math static methods/constants",
        "Number constructor/static predicates",
        "Number.prototype formatting",
        "IEEE-754 edge cases, -0, NaN, infinities",
        "safe-integer and parsing behavior"
      ],
      "ownership_notes": [
        "Reuse COERCION for ToNumber/ToNumeric.",
        "Operator arithmetic remains owned by OPERATORS."
      ]
    },
    {
