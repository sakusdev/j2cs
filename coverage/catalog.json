{
  "version": 1,
  "description": "Coverage targets used by tools/coverage_gap.py. Missing/thin/runtime-heavy targets are ranked for autonomous workstream generation.",
  "workstreams": [
    {
      "id": "VALUES_SYMBOL_BIGINT",
      "title": "Primitive values, Symbol, and BigInt",
      "priority": 100,
      "minimum_rules": 35,
      "match": {
        "categories": [
          "values"
        ],
        "id_prefixes": [
          "values.",
          "symbol.",
          "bigint."
        ]
      },
      "required_id_prefixes": [
        "symbol.",
        "bigint.",
        "values.undefined",
        "values.nan"
      ],
      "scope": [
        "Symbol construction/registry/well-known symbols",
        "BigInt construction/conversion/arithmetic boundaries",
        "undefined/null/NaN/Infinity/-0 value-model rules",
        "typeof/value identity interactions not already owned by OPERATORS"
      ],
      "ownership_notes": [
        "Reuse COERCION and OPERATORS instead of duplicating conversions/operators.",
        "Keep abstract value-model semantics separate from API-specific workstreams."
      ]
    },
    {
      "id": "ITERATORS_GENERATORS",
      "title": "Iterators, generators, and for-of",
      "priority": 98,
      "minimum_rules": 40,
      "match": {
        "categories": [
          "iteration",
          "iterators",
          "generators"
        ],
        "id_prefixes": [
          "iterator.",
          "iteration.",
          "generator."
        ]
      },
      "required_id_prefixes": [
        "iterator.",
        "generator.",
        "iteration.for-of"
      ],
      "scope": [
        "Iterator/Iterable protocols",
        "for...of and IteratorClose",
        "generator functions yield/next/return/throw",
        "yield* delegation",
        "sync iterator helpers where appropriate"
      ],
      "ownership_notes": [
        "Reuse FUNCTIONS and ASYNC; do not redefine Promise or generic call semantics.",
        "Array/String/Map/Set own container APIs; this workstream owns generic iterator protocol semantics."
      ]
    },
    {
      "id": "ERRORS_CONTROL_FLOW",
      "title": "Errors and abrupt completion",
      "priority": 96,
      "minimum_rules": 35,
      "match": {
        "categories": [
          "errors",
          "control_flow"
        ],
        "id_prefixes": [
          "error.",
          "errors.",
          "control."
        ]
      },
      "required_id_prefixes": [
        "error.",
        "control.throw",
        "control.try"
      ],
      "scope": [
        "throw/catch/finally",
        "Error subclasses and cause",
        "arbitrary thrown JS values",
        "abrupt completion propagation",
        "stack/message portability boundaries"
      ],
      "ownership_notes": [
        "Reuse FUNCTIONS/ASYNC for callback and promise propagation.",
        "Do not bake engine-specific stack text into native rules."
      ]
    },
    {
      "id": "MATH_NUMBER",
      "title": "Math and Number builtins",
      "priority": 94,
      "minimum_rules": 45,
      "match": {
