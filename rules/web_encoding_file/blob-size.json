{
  "id": "web.blob.size",
  "category": "web_encoding_file",
  "summary": "Read Blob byte length.",
  "source": {
    "pattern": "$blob.size",
    "requirements": {
      "receiver_inferred_as": "Blob",
      "builtin_webidl_member_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "WebBlob.GetSize",
    "template": "WebBlob.GetSize($blob)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "units": "bytes",
    "readonly": true,
    "range": "unsigned long long"
  },
  "caveats": [],
  "references": [
    "W3C File API"
  ],
  "tests": [
    {
      "name": "utf8 bytes",
      "input": "console.log(new Blob(['€']).size)",
      "expected_behavior": "prints 3"
    },
    {
      "name": "binary bytes",
      "input": "console.log(new Blob([new Uint8Array(7)]).size)",
      "expected_behavior": "prints 7"
    }
  ]
}
