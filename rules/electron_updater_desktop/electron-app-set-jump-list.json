{
  "id": "electron.app.set-jump-list",
  "category": "electron.updater_desktop",
  "summary": "setJumpList installs/removes custom Windows Jump List categories and returns a status string.",
  "source": {
    "pattern": "app.setJumpList($categories)",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.AppDesktop.SetJumpList",
    "template": "ElectronCompat.AppDesktop.SetJumpList($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "platform": "win32",
    "null": "remove custom Jump List",
    "statuses": [
      "ok",
      "error",
      "invalidSeparatorError",
      "fileTypeRegistrationError",
      "customCategoryAccessDeniedError"
    ]
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/app"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.setJumpList($categories)",
      "expected_behavior": "status string preserved"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.setJumpList($categories)",
      "expected_behavior": "false/exception substitution would lose Electron contract"
    }
  ]
}
