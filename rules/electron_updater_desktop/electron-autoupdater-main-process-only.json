{
  "id": "electron.autoupdater.main-process-only",
  "category": "electron.updater_desktop",
  "summary": "autoUpdater is a main-process API boundary.",
  "source": {
    "pattern": "require('electron').autoUpdater",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "ElectronCompat.AutoUpdater.RequireMainProcess",
    "template": "ElectronCompat.AutoUpdater.RequireMainProcess($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "process": "main",
    "renderer": "must use IPC/host bridge if exposed"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/auto-updater"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: require('electron').autoUpdater",
      "expected_behavior": "main process access is valid"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: require('electron').autoUpdater",
      "expected_behavior": "renderer translation must not synthesize direct updater access"
    }
  ]
}
