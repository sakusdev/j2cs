{
  "id": "electron.dock.get-menu",
  "category": "electron.updater_desktop",
  "summary": "dock.getMenu returns the installed Menu or null.",
  "source": {
    "pattern": "app.dock.getMenu()",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.Dock.GetMenu",
    "template": "ElectronCompat.Dock.GetMenu($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return": "Menu | null"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/dock"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.dock.getMenu()",
      "expected_behavior": "installed menu identity preserved"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.dock.getMenu()",
      "expected_behavior": "no menu returns null rather than undefined"
    }
  ]
}
