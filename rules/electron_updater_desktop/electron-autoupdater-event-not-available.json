{
  "id": "electron.autoupdater.event-not-available",
  "category": "electron.updater_desktop",
  "summary": "update-not-available reports a completed check with no newer applicable update.",
  "source": {
    "pattern": "autoUpdater.on('update-not-available',$listener)",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "ElectronCompat.AutoUpdater.OnEvent",
    "template": "ElectronCompat.AutoUpdater.OnEvent($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "event": "update-not-available"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/auto-updater"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: autoUpdater.on('update-not-available',$listener)",
      "expected_behavior": "no-update event delivered"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: autoUpdater.on('update-not-available',$listener)",
      "expected_behavior": "must be distinct from error"
    }
  ]
}
