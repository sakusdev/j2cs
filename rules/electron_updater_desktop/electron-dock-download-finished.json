{
  "id": "electron.dock.download-finished",
  "category": "electron.updater_desktop",
  "summary": "downloadFinished notifies the macOS Dock Downloads stack for files inside Downloads.",
  "source": {
    "pattern": "app.dock.downloadFinished($filePath)",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.Dock.DownloadFinished",
    "template": "ElectronCompat.Dock.DownloadFinished($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "platform": "darwin",
    "condition": "path inside Downloads folder",
    "effect": "bounce Downloads stack"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/dock"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.dock.downloadFinished($filePath)",
      "expected_behavior": "Downloads path triggers host notification"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.dock.downloadFinished($filePath)",
      "expected_behavior": "ordinary path must not be reinterpreted as app bounce"
    }
  ]
}
