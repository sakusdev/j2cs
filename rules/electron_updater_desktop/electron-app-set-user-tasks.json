  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "platform": "win32",
    "return": "boolean",
    "argument": "Task[]"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/app"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.setUserTasks($tasks)",
      "expected_behavior": "success boolean preserved"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.setUserTasks($tasks)",
      "expected_behavior": "must not pretend support on non-Windows"
    }
  ]
