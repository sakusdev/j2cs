{
  "id": "electron.app.clear-recent-documents",
  "category": "electron.updater_desktop",
  "summary": "clearRecentDocuments clears the OS-managed recent documents list on macOS/Windows.",
  "source": {
    "pattern": "app.clearRecentDocuments()",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.AppDesktop.ClearRecentDocuments",
    "template": "ElectronCompat.AppDesktop.ClearRecentDocuments($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "effect": "clear host list"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/app"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.clearRecentDocuments()",
      "expected_behavior": "host list cleared"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.clearRecentDocuments()",
      "expected_behavior": "not equivalent to deleting app files"
    }
  ]
}
