{
  "id": "electron.dock.show",
  "category": "electron.updater_desktop",
  "summary": "dock.show returns Promise<void> resolving when the Dock icon is shown.",
  "source": {
    "pattern": "app.dock.show()",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "ElectronCompat.Dock.Show",
    "template": "ElectronCompat.Dock.Show($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return": "Promise<void>",
    "resolve": "icon shown"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/dock"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: app.dock.show()",
      "expected_behavior": "promise shape preserved"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: app.dock.show()",
      "expected_behavior": "must not become synchronous void"
    }
  ]
}
