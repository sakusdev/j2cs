{
  "id": "electron.autoupdater.msix-allow-any-version",
  "category": "electron.updater_desktop",
  "summary": "allowAnyVersion applies to Windows MSIX feed configuration and allows downgrade candidates.",
  "source": {
    "pattern": "autoUpdater.setFeedURL({url:$url,allowAnyVersion:$flag})",
    "requirements": {
      "electron_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "ElectronCompat.AutoUpdater.SetFeedURL",
    "template": "ElectronCompat.AutoUpdater.SetFeedURL($args)",
    "notes": "Preserve Electron host/platform behavior rather than substituting a superficially similar .NET API."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "platform": "Windows MSIX",
    "default": false,
    "true": "older versions may be considered"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/auto-updater"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "// Electron host test: autoUpdater.setFeedURL({url:$url,allowAnyVersion:$flag})",
      "expected_behavior": "default blocks downgrade-style candidate"
    },
    {
      "name": "edge",
      "input": "// Electron semantic edge: autoUpdater.setFeedURL({url:$url,allowAnyVersion:$flag})",
      "expected_behavior": "true is platform-specific and must not leak to macOS semantics"
    }
  ]
}
