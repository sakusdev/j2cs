{
  "id": "css.style.custom-property-case-sensitive",
  "category": "css_renderer",
  "summary": "Custom-property names remain case-sensitive through CSS declaration lookup and mutation.",
  "source": {
    "pattern": "CSSOM operation on --$customName",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "case_sensitive": true,
    "namespace": "distinct declarations for differently-cased names"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.setProperty('--A','1'); e.style.setProperty('--a','2'); console.log(e.style.length);",
      "expected_behavior": "both custom declarations can coexist"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); e.style.setProperty('--A','1'); e.style.removeProperty('--a'); console.log(e.style.getPropertyValue('--A'));",
      "expected_behavior": "removing different case does not remove original"
    }
  ]
}
