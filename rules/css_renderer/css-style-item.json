{
  "id": "css.style.item",
  "category": "css_renderer",
  "summary": "CSSStyleDeclaration.item(index) returns the property name at declaration order position or empty string.",
  "source": {
    "pattern": "$declaration.item($index)",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "in_range": "property name in declaration order",
    "out_of_range": "empty string"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.cssText='color:red;width:1px'; console.log(e.style.item(0));",
      "expected_behavior": "returns the first declaration property name"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); console.log(e.style.item(9)==='');",
      "expected_behavior": "out-of-range returns empty string"
    }
  ]
}
