{
  "id": "css.style.set-property-custom",
  "category": "css_renderer",
  "summary": "setProperty preserves custom-property names case-sensitively and parses custom-property value syntax.",
  "source": {
    "pattern": "$declaration.setProperty('--$name',$value,$priority?)",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "name": "case-sensitive",
    "value": "custom-property declaration semantics",
    "important": "priority flag is separate from value"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.setProperty('--X','1'); console.log(e.style.getPropertyValue('--X'));",
      "expected_behavior": "returns 1"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); e.style.setProperty('--X','1'); console.log(e.style.getPropertyValue('--x')==='');",
      "expected_behavior": "custom-property names remain case-sensitive"
    }
  ]
}
