{
  "id": "css.style.set-property-priority",
  "category": "css_renderer",
  "summary": "setProperty accepts empty priority or ASCII-case-insensitive important and stores importance separately.",
  "source": {
    "pattern": "$declaration.setProperty($property,$value,$priority)",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "accepted": [
      "",
      "important case-insensitive"
    ],
    "important": "sets declaration important flag"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.setProperty('color','red','IMPORTANT'); console.log(e.style.getPropertyPriority('color'));",
      "expected_behavior": "returns important"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); e.style.setProperty('color','red',''); console.log(e.style.getPropertyPriority('color')==='');",
      "expected_behavior": "empty priority clears importance"
    }
  ]
}
