{
  "id": "css.style.named-property-accessor",
  "category": "css_renderer",
  "summary": "CSSStyleProperties named IDL attributes map supported CSS property names to getPropertyValue/setProperty semantics.",
  "source": {
    "pattern": "$style.$camelCasedProperty",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "mapping": "CSS property to IDL attribute algorithm",
    "get": "getPropertyValue",
    "set": "setProperty",
    "legacy_null": "null becomes empty string"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.backgroundColor='red'; console.log(e.style.getPropertyValue('background-color'));",
      "expected_behavior": "named setter updates corresponding CSS property"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); e.style.backgroundColor='red'; e.style.backgroundColor=null; console.log(e.style.backgroundColor==='');",
      "expected_behavior": "LegacyNullToEmptyString clears declaration"
    }
  ]
}
