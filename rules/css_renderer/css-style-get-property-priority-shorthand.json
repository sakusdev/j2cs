{
  "id": "css.style.get-property-priority-shorthand",
  "category": "css_renderer",
  "summary": "A shorthand priority is important only when every mapped longhand reports important.",
  "source": {
    "pattern": "$declaration.getPropertyPriority($shorthand)",
    "requirements": {
      "web_css_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeCss.Style",
    "template": "NativeCss.Style($args)",
    "notes": "Preserve CSSOM/parser/renderer semantics; this is not an ordinary C# dictionary or geometry-field access."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "all_longhands_important": "important",
    "otherwise": "empty string"
  },
  "caveats": [],
  "references": [
    "https://drafts.csswg.org/cssom/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const e=document.createElement('div'); e.style.setProperty('margin','1px','important'); console.log(e.style.getPropertyPriority('margin'));",
      "expected_behavior": "returns important"
    },
    {
      "name": "edge",
      "input": "const e=document.createElement('div'); e.style.setProperty('margin-top','1px','important'); console.log(e.style.getPropertyPriority('margin'));",
      "expected_behavior": "returns empty string when shorthand longhands are incomplete/not uniformly important"
    }
  ]
}
