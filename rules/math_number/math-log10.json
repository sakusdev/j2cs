{
  "id": "math.log10",
  "category": "math_number",
  "summary": "Compute implementation-approximated base-10 logarithm.",
  "source": {
    "pattern": "Math.log10($x)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%Math%",
      "method_resolution_intrinsic": true,
      "to_number_lowering": "reuse COERCION"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsMath.Log10",
    "template": "JsMath.Log10($x)",
    "notes": "Compose with canonical COERCION ToNumber before the numeric kernel; if ToNumber requires runtime, the whole expression inherits that dependency."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "argument_conversion": "ECMAScript ToNumber via canonical COERCION rules",
    "one": "+0",
    "both_zeros": "-Infinity",
    "negative": "NaN",
    "positive_infinity": "Infinity"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/numbers-and-dates.html"
  ],
  "tests": [
    {
      "name": "power of ten",
      "input": "console.log(Math.log10(100));",
      "expected_behavior": "prints 2"
    },
    {
      "name": "zero",
      "input": "console.log(Math.log10(0));",
      "expected_behavior": "prints -Infinity"
    }
  ]
}
