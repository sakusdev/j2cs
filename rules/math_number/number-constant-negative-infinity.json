  "tests": [
    {
      "name": "constant value",
      "input": "console.log(Number.NEGATIVE_INFINITY < 0);",
      "expected_csharp": "var x = double.NegativeInfinity;",
      "expected_behavior": "prints true"
    },
    {
      "name": "binding requirement",
      "input": "const N={}; N.NEGATIVE_INFINITY=123; console.log(N.NEGATIVE_INFINITY);",
