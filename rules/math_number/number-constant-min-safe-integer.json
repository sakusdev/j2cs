{
  "id": "number.constant.min-safe-integer",
  "category": "math_number",
  "summary": "Lower intrinsic Number.MIN_SAFE_INTEGER to the corresponding binary64 constant.",
  "source": {
    "pattern": "Number.MIN_SAFE_INTEGER",
    "requirements": {
      "binding_resolves_to_intrinsic": "%Number%",
      "intrinsic_constant_property": true
    }
  },
  "target": {
    "kind": "csharp",
    "template": "-9007199254740991d"
  },
  "strategy": "native",
  "confidence": "high",
  "semantics": {
    "value": "-(2^53 - 1)",
    "property_read": "safe only when Number binding resolves to intrinsic constructor"
  },
  "caveats": [
    "Apply only to the intrinsic Number constructor binding."
  ],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/numbers-and-dates.html"
  ],
  "tests": [
    {
      "name": "constant value",
      "input": "console.log(Number.MIN_SAFE_INTEGER);",
      "expected_csharp": "var x = -9007199254740991d;",
      "expected_behavior": "prints -9007199254740991"
    },
    {
      "name": "binding requirement",
      "input": "const N={}; N.MIN_SAFE_INTEGER=123; console.log(N.MIN_SAFE_INTEGER);",
      "expected_behavior": "prints 123; this rule does not apply to a non-intrinsic receiver"
    }
  ]
}
