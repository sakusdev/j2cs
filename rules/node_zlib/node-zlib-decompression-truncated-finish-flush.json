{
  "id": "node.zlib.decompression.truncated-finish-flush",
  "category": "node_zlib",
  "summary": "Decompression normally rejects truncated input; a non-finish finishFlush such as Z_SYNC_FLUSH can intentionally permit partial output.",
  "source": {
    "pattern": "zlib.unzip($truncated,{finishFlush:$kind},$callback)",
    "requirements": {
      "node_builtin_zlib_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeZlib.Decompress",
    "template": "NodeZlib.Decompress($args)",
    "notes": "Preserve Node Buffer/options/error semantics; platform compression libraries are usable only behind this compatibility contract."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "default": "truncated input errors",
    "Z_SYNC_FLUSH": "may return available prefix without integrity/end validation",
    "warning": "partial output cannot prove stream completeness"
  },
  "caveats": [],
  "references": [
    "https://nodejs.org/api/zlib.html"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const z=require('node:zlib'); const b=Buffer.from('eJzT0yMA','base64'); z.unzip(b,{finishFlush:z.constants.Z_SYNC_FLUSH},(e,o)=>console.log(!e,!!o));",
      "expected_behavior": "matches Node.js zlib behavior"
    },
    {
      "name": "edge",
      "input": "const z=require('node:zlib'); const b=Buffer.from('eJzT0yMA','base64'); z.unzip(b,(e)=>console.log(Boolean(e)));",
      "expected_behavior": "matches Node.js zlib edge/error behavior"
    }
  ]
}
