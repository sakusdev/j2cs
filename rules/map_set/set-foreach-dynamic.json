{"id":"set.prototype.foreach.dynamic-callback","category":"map_set","summary":"Use runtime fallback when Set.forEach callback invocation cannot be statically lowered.","source":{"pattern":"$set.forEach($callback, $thisArg)","requirements":{"receiver_inferred_builtin_set":true,"builtin_member_not_overridden_or_shadowed":true,"receiver_not_proxy":true,"callback_not_statically_lowerable":true}},"target":{"kind":"runtime","template":"JsRuntime.SetForEach($set, $callback, $thisArg)"},"strategy":"runtime","confidence":"high","semantics":{"callability_checked":"at runtime","callback_throw":"propagates immediately","iteration":"live insertion-ordered Set iteration"},"caveats":[],"references":["https://tc39.es/ecma262/multipage/keyed-collections.html"],"tests":[{"name":"non-callable throws","input":"try{new Set([1]).forEach(null)}catch(e){console.log(e.name)}","expected_behavior":"prints TypeError"},{"name":"throw stops callbacks","input":"const s=new Set([1,2]);let n=0;try{s.forEach(()=>{n++;throw 1})}catch(e){}console.log(n);","expected_behavior":"prints 1"}]}
