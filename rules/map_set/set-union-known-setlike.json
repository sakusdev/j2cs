{
  "id": "set.prototype.union.known-setlike",
  "category": "map_set",
  "summary": "Union with a statically analyzable set-like object using its size/has/keys protocol rather than @@iterator.",
  "source": {
    "pattern": "$set.union($other)",
    "requirements": {
      "receiver_inferred_builtin_set": true,
      "builtin_member_not_overridden_or_shadowed": true,
      "receiver_not_proxy": true,
      "other_not_builtin_set": true,
      "other_set_like_shape_proven": true,
      "size_is_known_data_property": true,
      "has_is_known_callable": true,
      "keys_is_known_callable": true,
      "keys_iterator_lowerable": true,
      "other_not_proxy": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsSet.UnionSetLike",
    "template": "JsSet.UnionSetLike($set, $other)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "get_set_record": "size is converted to Number/Integer; has and keys are callable",
    "iteration": "call other.keys() with other as this; @@iterator is irrelevant",
    "result_order": "receiver values then new keys from other"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/keyed-collections.html"
  ],
  "tests": [
    {
      "name": "set-like accepted",
      "input": "const o={size:2,has(){return false},*keys(){yield 3;yield 4}}; console.log([...new Set([1]).union(o)]);",
      "expected_behavior": "prints [1,3,4]"
    },
    {
      "name": "iterator property ignored",
      "input": "const o={size:1,has(){return false},*keys(){yield 2},[Symbol.iterator](){throw 'bad'}}; console.log([...new Set([1]).union(o)]);",
      "expected_behavior": "prints [1,2]"
    }
  ]
}
