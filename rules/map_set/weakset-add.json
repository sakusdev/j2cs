{"id":"weakset.prototype.add","category":"map_set","summary":"Add a WeakSet value using runtime-managed weak storage and enforce CanBeHeldWeakly.","source":{"pattern":"$weakSet.add($value)","requirements":{"receiver_inferred_builtin_weakset":true,"builtin_member_not_overridden_or_shadowed":true,"receiver_not_proxy":true}},"target":{"kind":"runtime","template":"JsRuntime.WeakSetAdd($weakSet,$value)"},"strategy":"runtime","confidence":"high","semantics":{"valid_value":"Object or non-registered Symbol","invalid_value":"throws TypeError","return_value":"receiver"},"caveats":["Weak collections are not enumerable and expose no size because observing liveness would expose garbage-collection behavior.","CanBeHeldWeakly accepts Objects and non-registered Symbols; ordinary primitives and registered Symbols are rejected for insertion."],"references":["https://tc39.es/ecma262/multipage/keyed-collections.html"],"tests":[{"name":"object and chaining","input":"const k={};const w=new WeakSet();console.log(w.add(k)===w,w.has(k));","expected_behavior":"prints true true"},{"name":"registered symbol rejected","input":"try{new WeakSet().add(Symbol.for('x'))}catch(e){console.log(e.name)}","expected_behavior":"prints TypeError"}]}
