{"id":"map.prototype.set","category":"map_set","summary":"Set a builtin Map entry while preserving SameValueZero key identity, insertion order, and receiver return value.","source":{"pattern":"$map.set($key, $value)","requirements":{"receiver_inferred_builtin_map":true,"builtin_member_not_overridden_or_shadowed":true,"receiver_not_proxy":true}},"target":{"kind":"helper","template":"JsMap.Set($map, $key, $value)","helper":"JsMap.Set"},"strategy":"helper","confidence":"high","semantics":{"key_equality":"SameValueZero / canonicalized -0","existing_key":"replace value in place without reordering","new_key":"append at end","return_value":"receiver"},"caveats":["Dictionary assignment alone does not establish required enumeration/live-iterator semantics."],"references":["https://tc39.es/ecma262/multipage/keyed-collections.html","https://tc39.es/ecma262/multipage/abstract-operations.html"],"tests":[{"name":"returns receiver and inserts","input":"const m=new Map(); console.log(m.set('x',1)===m, [...m]);","expected_behavior":"prints true and [['x',1]]"},{"name":"updating existing key does not move it","input":"const m=new Map([['a',1],['b',2]]); m.set('a',3); console.log([...m.keys()]);","expected_behavior":"prints ['a','b']"}]}
