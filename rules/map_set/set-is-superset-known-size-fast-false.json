{
  "id": "set.prototype.is-superset.known-size-fast-false",
  "category": "map_set",
  "summary": "isSupersetOf size short-circuit for a statically analyzable set-like object.",
  "source": {
    "pattern": "$set.isSupersetOf($other)",
    "requirements": {
      "receiver_inferred_builtin_set": true,
      "builtin_member_not_overridden_or_shadowed": true,
      "receiver_not_proxy": true,
      "other_not_builtin_set": true,
      "other_set_like_shape_proven": true,
      "size_is_known_data_property": true,
      "has_is_known_callable": true,
      "keys_is_known_callable": true,
      "keys_iterator_lowerable": true,
      "other_not_proxy": true,
      "size_relation": "receiver_size < other_reported_size"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsSet.IsSupersetOfSetLike",
    "template": "JsSet.IsSupersetOfSetLike($set, $other)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "result": "Boolean false",
    "protocol": "GetSetRecord still validates size, has, and keys before relation short-circuit",
    "no_scan": true
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/keyed-collections.html"
  ],
  "tests": [
    {
      "name": "valid set-like size rejects",
      "input": "const o={size:0,has(){throw 'should-not-call'},*keys(){throw 'should-not-iterate'}}; console.log(new Set([1]).isSupersetOf(o));",
      "expected_behavior": "returns false without invoking has/keys body after protocol acquisition"
    },
    {
      "name": "keys must still be callable",
      "input": "const o={size:0,has(){return false},keys:1}; try{new Set([1]).isSupersetOf(o)}catch(e){console.log(e.name)}",
      "expected_behavior": "prints TypeError before size-based return"
    }
  ]
}
