{"id":"weakmap.prototype.set","category":"map_set","summary":"Set a WeakMap entry through runtime-managed weak storage and enforce CanBeHeldWeakly.","source":{"pattern":"$weakMap.set($key,$value)","requirements":{"receiver_inferred_builtin_weakmap":true,"builtin_member_not_overridden_or_shadowed":true,"receiver_not_proxy":true}},"target":{"kind":"runtime","template":"JsRuntime.WeakMapSet($weakMap,$key,$value)"},"strategy":"runtime","confidence":"high","semantics":{"valid_key":"Object or non-registered Symbol","invalid_key":"throws TypeError","return_value":"receiver","comparison":"SameValue identity for weakly-held keys"},"caveats":["Weak collections are not enumerable and expose no size because observing liveness would expose garbage-collection behavior.","CanBeHeldWeakly accepts Objects and non-registered Symbols; ordinary primitives and registered Symbols are rejected for insertion."],"references":["https://tc39.es/ecma262/multipage/keyed-collections.html"],"tests":[{"name":"object key and chaining","input":"const k={};const w=new WeakMap();console.log(w.set(k,1)===w,w.get(k));","expected_behavior":"prints true 1"},{"name":"registered symbol rejected","input":"try{new WeakMap().set(Symbol.for('x'),1)}catch(e){console.log(e.name)}","expected_behavior":"prints TypeError"}]}
