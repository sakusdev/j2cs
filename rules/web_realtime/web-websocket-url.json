{
  "id": "web.websocket.url",
  "category": "web_realtime",
  "summary": "url exposes the serialized URL used by the connection.",
  "source": {
    "pattern": "$socket.url",
    "requirements": {
      "web_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsRuntime.WebSocketState",
    "template": "JsRuntime.WebSocketState($args)",
    "notes": "Preserve browser networking, task/event dispatch, URL/WebIDL conversion, and protocol state rather than mapping to a raw socket."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "readonly": true,
    "value": "serialized associated URL"
  },
  "caveats": [],
  "references": [
    "https://websockets.spec.whatwg.org/"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "socket.url",
      "expected_behavior": "returns connection URL"
    },
    {
      "name": "edge",
      "input": "socket.url='x'",
      "expected_behavior": "does not become a writable ordinary field"
    }
  ]
}
