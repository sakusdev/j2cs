{
  "id": "web.event-source.with-credentials",
  "category": "web_realtime",
  "summary": "withCredentials defaults false; true uses credentials mode include for connection/reconnection requests.",
  "source": {
    "pattern": "new EventSource($url,{withCredentials:$flag})",
    "requirements": {
      "web_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsRuntime.EventSourceState",
    "template": "JsRuntime.EventSourceState($args)",
    "notes": "Preserve browser networking, task/event dispatch, URL/WebIDL conversion, and protocol state rather than mapping to a raw socket."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "default": false,
    "true": "Use Credentials/include",
    "readonly": true
  },
  "caveats": [],
  "references": [
    "https://html.spec.whatwg.org/multipage/server-sent-events.html"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "new EventSource('/events',{withCredentials:true}).withCredentials",
      "expected_behavior": "true"
    },
    {
      "name": "edge",
      "input": "new EventSource('/events').withCredentials",
      "expected_behavior": "false"
    }
  ]
}
