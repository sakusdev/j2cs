{
  "id": "web.event-source.reconnect",
  "category": "web_realtime",
  "summary": "Recoverable end/failure queues error, transitions to CONNECTING, waits reconnect time, and fetches again.",
  "source": {
    "pattern": "recoverable EventSource connection loss",
    "requirements": {
      "web_builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.EventSource",
    "template": "JsRuntime.EventSource($args)",
    "notes": "Preserve browser networking, task/event dispatch, URL/WebIDL conversion, and protocol state rather than mapping to a raw socket."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "event": "error",
    "state": "CONNECTING",
    "delay": "server retry value or implementation default; host may back off further",
    "network": "new fetch attempt"
  },
  "caveats": [],
  "references": [
    "https://html.spec.whatwg.org/multipage/server-sent-events.html"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "temporary disconnect",
      "expected_behavior": "error then reconnect attempt"
    },
    {
      "name": "edge",
      "input": "source.close() during delay",
      "expected_behavior": "prevents reconnect"
    }
  ]
}
