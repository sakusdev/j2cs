  "id":"values.same-value.number","category":"values","summary":"SameValue for Numbers treats NaN as equal to NaN and distinguishes +0 from -0.","source":{"pattern":"[[SameValue]]($left, $right)","requirements":{"semantic_operation":"SameValue","left_type":"Number","right_type":"Number"}},"target":{"kind":"helper","template":"JsValues.SameValueNumber($left, $right)","helper":"JsValues.SameValueNumber","notes":"Do not use C# ==: it makes NaN unequal, and do not use Double.Equals alone: it does not distinguish signed zero."},"strategy":"helper","confidence":"high","semantics":{"nan_nan":true,"positive_zero_negative_zero":false,"other_numbers":"numeric equality"},"tests":[{"name":"NaN same value","input":"console.log(Object.is(NaN,NaN));","expected_behavior":"prints true"},{"name":"signed zeros differ","input":"console.log(Object.is(0,-0));","expected_behavior":"prints false"}],"references":["https://tc39.es/ecma262/2026/multipage/abstract-operations.html"]
