{
  "id": "array.prototype.values.holes",
  "category": "array",
  "summary": "Builtin Array values iterator yields undefined for holes rather than skipping them.",
  "source": {
    "pattern": "$array.values()",
    "requirements": {
      "method_resolution_intrinsic": true,
      "receiver_inferred_as_builtin_array": true,
      "receiver_not_proxy": true,
      "builtin_method_not_overridden": true,
      "holes_may_be_present": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Values",
    "template": "JsArray.Values($array)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "holes": "Get returns undefined and iterator yields it",
    "difference_from_array_iteration_methods": "map/filter callbacks may skip holes; iterator values does not"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "hole yielded",
      "input": "const r=[...[,1].values()]; console.log(r.length,r[0],r[1]);",
      "expected_behavior": "prints 2 undefined 1"
    },
    {
      "name": "prototype value visible",
      "input": "const a=[,]; Array.prototype[0]=9; try{console.log(a.values().next().value)}finally{delete Array.prototype[0]}",
      "expected_behavior": "prints 9"
    }
  ]
}
