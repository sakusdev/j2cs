{
  "id": "array.prototype.values.live-mutation",
  "category": "array",
  "summary": "Builtin Array values iterator reads each value at visit time and observes length changes until done.",
  "source": {
    "pattern": "$array.values()",
    "requirements": {
      "method_resolution_intrinsic": true,
      "receiver_inferred_as_builtin_array": true,
      "receiver_not_proxy": true,
      "builtin_method_not_overridden": true,
      "array_contents_or_length_may_mutate_during_iteration": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Values",
    "template": "JsArray.Values($array)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "value": "Get at visit time",
    "growth": "appended elements can be visited",
    "overwrite": "latest value observed",
    "done_sticky": true
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "overwrite before visit",
      "input": "const a=[1,2]; const it=a.values(); console.log(it.next().value); a[1]=7; console.log(it.next().value);",
      "expected_behavior": "prints 1 then 7"
    },
    {
      "name": "append before done",
      "input": "const a=[]; const it=a.values(); a.push(3); console.log(it.next().value);",
      "expected_behavior": "prints 3"
    }
  ]
}
