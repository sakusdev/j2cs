{
  "id": "array.prototype.fill",
  "category": "array",
  "summary": "Fill a clamped range in place with the exact supplied value and return the receiver.",
  "source": {
    "pattern": "$array.fill($value, $start, $end)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Fill",
    "template": "JsArray.Fill(...)",
    "notes": "Coerce/clamp start/end, assign the same value reference to each selected index, materialize holes in the filled range, and return the receiver."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "mutates_receiver": true,
    "returns_same_object": true,
    "index_coercion": "ToIntegerOrInfinity",
    "fills_holes": true
  },
  "caveats": [
    "Object values are reused by reference for every filled slot; do not clone them."
  ],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "fills range",
      "input": "const a=[1,2,3,4]; const r=a.fill(9,1,3); console.log(r===a,a.join(','));",
      "expected_behavior": "prints true 1,9,9,4"
    },
    {
      "name": "fills holes",
      "input": "const a=Array(2); a.fill(undefined); console.log(0 in a,1 in a);",
      "expected_behavior": "prints true true"
    },
    {
      "name": "negative indices",
      "input": "console.log([1,2,3].fill(0,-2,-1).join(','));",
      "expected_behavior": "prints 1,0,3"
    }
  ]
}
