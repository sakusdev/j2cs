{
  "id": "array.prototype.flat.zero-depth-sparse",
  "category": "array",
  "summary": "At effective depth 0, flat still copies present properties and skips holes instead of acting as slice.",
  "source": {
    "pattern": "$array.flat($depth)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true,
      "array_species_is_builtin_array": true,
      "depth_effectively_zero": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Flat",
    "template": "JsArray.Flat($array, 0)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "flatten_nested_arrays": false,
    "holes": "skipped and compacted",
    "difference_from_slice": "slice preserves holes; flat(0) removes holes"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "hole compacted",
      "input": "const r=[,1,,2].flat(0); console.log(r.length,r.join(','));",
      "expected_behavior": "prints 2 1,2"
    },
    {
      "name": "nested array not flattened",
      "input": "const x=[1]; const r=[x].flat(0); console.log(r[0]===x);",
      "expected_behavior": "prints true"
    }
  ],
  "caveats": [
    "Custom Symbol.species remains owned by the existing array.custom-species.runtime rule."
  ]
}
