{
  "id": "array.prototype.flatmap.dynamic-callback",
  "category": "array",
  "summary": "Use runtime call semantics when flatMap callback callability or Proxy behavior is dynamic.",
  "source": {
    "pattern": "$array.flatMap($callback, $thisArg)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true,
      "array_species_is_builtin_array": true,
      "callback_may_be_dynamic_callable_or_proxy": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.ArrayFlatMap",
    "template": "JsRuntime.ArrayFlatMap($array, $callback, $thisArg)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "callability": "TypeError if not callable before iteration",
    "call": "canonical [[Call]] with thisArg",
    "abrupt": "callback throw aborts immediately"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "noncallable",
      "input": "try{[1].flatMap(3)}catch(e){console.log(e.name)}",
      "expected_behavior": "prints TypeError"
    },
    {
      "name": "callable proxy",
      "input": "const f=new Proxy(x=>[x],{apply(t,th,a){return [a[0]+1]}}); console.log([1].flatMap(f)[0]);",
      "expected_behavior": "prints 2"
    }
  ],
  "caveats": [
    "Custom Symbol.species remains owned by the existing array.custom-species.runtime rule."
  ]
}
