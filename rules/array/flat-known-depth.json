{
  "id": "array.prototype.flat.known-depth-builtin",
  "category": "array",
  "summary": "Flatten a proven builtin Array to a statically known nonnegative depth.",
  "source": {
    "pattern": "$array.flat($depth)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true,
      "array_species_is_builtin_array": true,
      "depth_is_primitive_and_to_integer_or_infinity_lowerable": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Flat",
    "template": "JsArray.Flat($array, $depth)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "depth_conversion": "ToIntegerOrInfinity; negative becomes effective 0",
    "flatten_condition": "only actual Arrays",
    "holes": "skipped at every flattened level",
    "max_target_index": "2^53-1 then TypeError"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "depth two",
      "input": "console.log([1,[2,[3]]].flat(2).join(','));",
      "expected_behavior": "prints 1,2,3"
    },
    {
      "name": "negative depth",
      "input": "const r=[,1].flat(-1); console.log(r.length,0 in r,1 in r);",
      "expected_behavior": "prints 2 false true"
    }
  ],
  "caveats": [
    "Custom Symbol.species remains owned by the existing array.custom-species.runtime rule."
  ]
}
