{
  "id": "array.prototype.lastindexof",
  "category": "array",
  "summary": "Search backward using JavaScript strict equality while skipping holes.",
  "source": {
    "pattern": "$array.lastIndexOf($searchElement, $fromIndex)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.LastIndexOf",
    "template": "JsArray.LastIndexOf(...)",
    "notes": "Use IsStrictlyEqual, process optional fromIndex exactly, and skip absent properties."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "mutates_receiver": false,
    "comparison": "IsStrictlyEqual",
    "direction": "descending",
    "skips_holes": true,
    "not_found": -1
  },
  "caveats": [
    "Omitted fromIndex differs from explicit undefined: omitted starts at length-1, explicit undefined coerces to +0."
  ],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "returns largest index",
      "input": "console.log([1,2,1].lastIndexOf(1));",
      "expected_behavior": "prints 2"
    },
    {
      "name": "NaN does not match",
      "input": "console.log([NaN].lastIndexOf(NaN));",
      "expected_behavior": "prints -1"
    },
    {
      "name": "explicit undefined fromIndex",
      "input": "console.log([1,2,1].lastIndexOf(1,undefined));",
      "expected_behavior": "prints 0"
    }
  ]
}
