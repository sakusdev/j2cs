{
  "id": "array.prototype.splice",
  "category": "array",
  "summary": "Delete and/or insert in place and return an array of deleted elements.",
  "source": {
    "pattern": "$array.splice($start, $deleteCount, ...$items)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true,
      "array_species_is_builtin_array": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.Splice",
    "template": "JsArray.Splice(...)",
    "notes": "Preserve the omitted-vs-explicit-undefined deleteCount distinction, index coercion, holes, receiver mutation, and deleted-array creation."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "mutates_receiver": true,
    "returns_deleted_array": true,
    "preserves_holes": true,
    "omitted_deleteCount_differs_from_undefined": true
  },
  "caveats": [
    "RemoveRange/InsertRange do not preserve holes or omitted-argument semantics.",
    "Custom Symbol.species requires runtime fallback."
  ],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "delete and insert",
      "input": "const a=[1,2,3]; const d=a.splice(1,1,'x','y'); console.log(a.join(','),d.join(','));",
      "expected_behavior": "prints 1,x,y,3 2"
    },
    {
      "name": "omitted deleteCount deletes to end",
      "input": "const a=[1,2,3]; console.log(a.splice(1).join(','),a.join(','));",
      "expected_behavior": "prints 2,3 1"
    },
    {
      "name": "explicit undefined deletes zero",
      "input": "const a=[1,2,3]; const d=a.splice(1,undefined,'x'); console.log(d.length,a.join(','));",
      "expected_behavior": "prints 0 1,x,2,3"
    },
    {
      "name": "deleted array preserves hole",
      "input": "const a=[,1]; const d=a.splice(0,1); console.log(d.length,0 in d,d[0],a.length,a[0]);",
      "expected_behavior": "prints 1 false undefined 1 1"
    }
  ]
}
