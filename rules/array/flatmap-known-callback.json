{
  "id": "array.prototype.flatmap.known-callback",
  "category": "array",
  "summary": "Map present elements once then flatten only returned Arrays by one level.",
  "source": {
    "pattern": "$array.flatMap($callback, $thisArg)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true,
      "array_species_is_builtin_array": true,
      "callback_statically_callable_and_lowerable": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.FlatMap",
    "template": "JsArray.FlatMap($array, $callback, $thisArg)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "length_snapshot": true,
    "holes": "source holes skipped",
    "callback_arguments": [
      "value",
      "index",
      "array"
    ],
    "callback_this": "thisArg",
    "flatten_depth": 1,
    "flatten_condition": "IsArray(mappedValue) only"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "maps and flattens",
      "input": "console.log([1,2].flatMap(x=>[x,x*2]).join(','));",
      "expected_behavior": "prints 1,2,2,4"
    },
    {
      "name": "source holes skipped",
      "input": "let n=0; const r=[1,,3].flatMap(x=>{n++;return [x]}); console.log(n,r.join(','));",
      "expected_behavior": "prints 2 1,3"
    }
  ],
  "caveats": [
    "Custom Symbol.species remains owned by the existing array.custom-species.runtime rule."
  ]
}
