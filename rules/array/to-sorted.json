{
  "id": "array.prototype.tosorted",
  "category": "array",
  "summary": "Create a stably sorted copy without mutating the source; holes are read through as undefined.",
  "source": {
    "pattern": "$array.toSorted($comparator)",
    "requirements": {
      "receiver_inferred_as_builtin_array": true,
      "builtin_method_not_overridden": true,
      "receiver_not_proxy": true,
      "no_indexed_accessors_or_nonconfigurable_elements": true,
      "no_indexed_prototype_properties": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsArray.ToSorted",
    "template": "JsArray.ToSorted(...)",
    "notes": "Read through every source index, then apply JavaScript stable sort semantics to a new intrinsic Array. The source is not mutated."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "mutates_receiver": false,
    "returns_new_array": true,
    "stable": true,
    "holes_become_present_undefined": true,
    "non_callable_comparator": "TypeError unless comparator is undefined"
  },
  "caveats": [
    "Do not implement as slice().sort(): slice preserves holes whereas toSorted uses read-through-holes semantics."
  ],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/indexed-collections.html"
  ],
  "tests": [
    {
      "name": "does not mutate source",
      "input": "const a=[3,1,2]; const b=a.toSorted((x,y)=>x-y); console.log(a.join(','),b.join(','));",
      "expected_behavior": "prints 3,1,2 1,2,3"
    },
    {
      "name": "default lexicographic",
      "input": "console.log([10,2].toSorted().join(','));",
      "expected_behavior": "prints 10,2"
    },
    {
      "name": "hole becomes present undefined",
      "input": "const b=[,1].toSorted(); console.log(b.length,1 in b);",
      "expected_behavior": "prints 2 true"
    },
    {
      "name": "non-callable comparator throws",
      "input": "try { [1,2].toSorted(0); } catch(e) { console.log(e.name); }",
      "expected_behavior": "prints TypeError"
    }
  ]
}
