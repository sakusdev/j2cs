{
  "id": "web.indexeddb.delete-database",
  "category": "web_indexeddb",
  "summary": "Delete database asynchronously",
  "source": {
    "pattern": "indexedDB.deleteDatabase(name)",
    "requirements": {
      "intrinsic_indexeddb_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.JsIndexedDb.DeleteDatabase(/* lowered operands */)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "request_model": "event-driven IDBRequest lifecycle",
    "transaction_lifetime": "task-sensitive active/inactive state",
    "structured_clone": "values preserve IndexedDB structured-clone behavior"
  },
  "caveats": [
    "Open connections can block deletion."
  ],
  "references": [
    "https://w3c.github.io/IndexedDB/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "indexedDB.deleteDatabase(name)",
      "expected_behavior": "Delete database asynchronously"
    },
    {
      "name": "edge semantics",
      "input": "indexedDB.deleteDatabase(name)",
      "expected_behavior": "Open connections can block deletion."
    }
  ]
}
