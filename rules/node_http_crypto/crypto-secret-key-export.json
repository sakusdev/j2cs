{
  "id": "node.crypto.secret-key-export",
  "category": "node_http_crypto",
  "summary": "Export raw secret KeyObject material.",
  "source": {
    "pattern": "$keyObject.export()",
    "requirements": {
      "receiver_inferred_as": "node:crypto secret KeyObject",
      "builtin_method_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeCrypto.ExportSecretKey",
    "template": "NodeCrypto.ExportSecretKey($keyObject)",
    "notes": "Returns a new Buffer containing secret bytes; mutating returned Buffer does not rewrite the KeyObject."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "notes": "Returns a new Buffer containing secret bytes; mutating returned Buffer does not rewrite the KeyObject."
  },
  "caveats": [
    "Preserve Node Buffer/ArrayBuffer, encoding, validation, provider, and callback semantics rather than only cryptographic mathematical output."
  ],
  "references": [
    "https://nodejs.org/api/crypto.html",
    "rules/binary/buffer-from.json"
  ],
  "tests": [
    {
      "name": "normal semantics",
      "input": "Buffer.isBuffer(key.export())",
      "expected_behavior": "true"
    },
    {
      "name": "edge semantics",
      "input": "const b=key.export(); b[0]^=255; key.export()[0]",
      "expected_behavior": "original key byte remains unchanged"
    }
  ]
}
