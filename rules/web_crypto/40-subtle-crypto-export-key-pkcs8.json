{
  "id": "web.subtle-crypto.export-key.pkcs8",
  "category": "web_crypto",
  "summary": "Export private key as PKCS#8.",
  "source": {
    "pattern": "subtle.exportKey('pkcs8',privateKey)",
    "requirements": {
      "intrinsic_web_crypto_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebCrypto.ExportKey",
    "template": "JsWebCrypto.ExportKey(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "webcrypto_contract": true,
    "binary": "reuse BINARY BufferSource semantics",
    "async": "reuse ASYNC Promise job/settlement semantics"
  },
  "caveats": [
    "Requires extractable private key."
  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "subtle.exportKey('pkcs8',privateKey)",
      "expected_behavior": "Export private key as PKCS#8."
    },
    {
      "name": "semantic trap",
      "input": "subtle.exportKey('pkcs8',privateKey)",
      "expected_behavior": "Requires extractable private key."
    }
  ]
}
