{
  "id": "web.crypto.get-random-values.type",
  "category": "web_crypto",
  "summary": "Reject floating-point/DataView/non-integer inputs.",
  "source": {
    "pattern": "crypto.getRandomValues(view)",
    "requirements": {
      "intrinsic_web_crypto_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebCrypto.GetRandomValues",
    "template": "JsWebCrypto.GetRandomValues(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "webcrypto_contract": true,
    "binary": "reuse BINARY BufferSource semantics",
    "async": "reuse ASYNC Promise job/settlement semantics"
  },
  "caveats": [
    "Invalid view type throws TypeMismatchError."
  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "crypto.getRandomValues(view)",
      "expected_behavior": "Reject floating-point/DataView/non-integer inputs."
    },
    {
      "name": "semantic trap",
      "input": "crypto.getRandomValues(view)",
      "expected_behavior": "Invalid view type throws TypeMismatchError."
    }
  ]
}
