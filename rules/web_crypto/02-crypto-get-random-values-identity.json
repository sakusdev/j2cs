  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "crypto.getRandomValues(array) === array",
      "expected_behavior": "Preserve getRandomValues input object identity."
    },
    {
      "name": "semantic trap",
      "input": "crypto.getRandomValues(array) === array",
      "expected_behavior": "Returns the exact same TypedArray object."
    }
  ]
