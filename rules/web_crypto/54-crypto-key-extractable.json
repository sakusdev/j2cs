  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "key.extractable",
      "expected_behavior": "Expose whether raw key material may be exported."
    },
    {
      "name": "semantic trap",
      "input": "key.extractable",
      "expected_behavior": "False must be enforced by export/wrap operations."
    }
  ]
