{
  "id": "web.crypto-key.extractable",
  "category": "web_crypto",
  "summary": "Expose whether raw key material may be exported.",
  "source": {
    "pattern": "key.extractable",
    "requirements": {
      "intrinsic_web_crypto_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebCrypto.KeyExtractable",
    "template": "JsWebCrypto.KeyExtractable(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "webcrypto_contract": true,
    "binary": "reuse BINARY BufferSource semantics",
