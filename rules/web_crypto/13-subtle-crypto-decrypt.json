{
  "id": "web.subtle-crypto.decrypt",
  "category": "web_crypto",
  "summary": "Decrypt BufferSource with WebCrypto validation.",
  "source": {
    "pattern": "subtle.decrypt(algorithm,key,data)",
    "requirements": {
      "intrinsic_web_crypto_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebCrypto.Decrypt",
    "template": "JsWebCrypto.Decrypt(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "webcrypto_contract": true,
    "binary": "reuse BINARY BufferSource semantics",
    "async": "reuse ASYNC Promise job/settlement semantics"
  },
  "caveats": [
    "Authentication/padding failures reject rather than returning partial plaintext."
  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "subtle.decrypt(algorithm,key,data)",
      "expected_behavior": "Decrypt BufferSource with WebCrypto validation."
    },
    {
      "name": "semantic trap",
      "input": "subtle.decrypt(algorithm,key,data)",
      "expected_behavior": "Authentication/padding failures reject rather than returning partial plaintext."
    }
  ]
}
