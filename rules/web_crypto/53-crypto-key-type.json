  "summary": "Expose secret/public/private key type.",
  "source": {
    "pattern": "key.type",
    "requirements": {
      "intrinsic_web_crypto_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebCrypto.KeyType",
    "template": "JsWebCrypto.KeyType(/* lowered operands */)"
  },
