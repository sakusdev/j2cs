  ],
  "references": [
    "https://www.w3.org/TR/WebCryptoAPI/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "key.type",
      "expected_behavior": "Expose secret/public/private key type."
    },
    {
      "name": "semantic trap",
      "input": "key.type",
      "expected_behavior": "Value is bound to internal CryptoKey type."
    }
  ]
