{
  "id": "object.prototype.property-is-enumerable",
  "category": "object",
  "summary": "Check whether an own property exists and its [[Enumerable]] attribute is true.",
  "source": {
    "pattern": "$obj.propertyIsEnumerable($key)",
    "requirements": {
      "receiver_method_resolves_to_builtin_Object_prototype_propertyIsEnumerable": true,
      "receiver_not_proxy": true,
      "object_representation_tracks_attributes": true
    }
  },
  "target": {
    "kind": "helper",
    "template": "JsObject.PropertyIsEnumerable($obj, $key)",
    "helper": "JsObject.PropertyIsEnumerable"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "this": "ToObject(this)",
    "key": "ToPropertyKey",
    "result": "false if absent; otherwise descriptor.[[Enumerable]]",
    "getter": "property value is not read"
  },
  "caveats": [
    "Requires descriptor metadata; a Dictionary alone cannot distinguish non-enumerable properties."
  ],
  "references": [
    "ECMAScript 2026 §20.1.3.4 Object.prototype.propertyIsEnumerable"
  ],
  "tests": [
    {
      "name": "enumerable own property",
      "input": "console.log(({a:1}).propertyIsEnumerable('a'));",
      "expected_behavior": "prints true"
    },
    {
      "name": "nonenumerable false",
      "input": "const x={}; Object.defineProperty(x,'a',{value:1}); console.log(x.propertyIsEnumerable('a'));",
      "expected_behavior": "prints false"
    }
  ]
}
