{
  "id": "object.constructor.call",
  "category": "object",
  "summary": "Preserve Object constructor/call semantics for objects, primitives, null, and undefined.",
  "source": {
    "pattern": "Object($value) or new Object($value)",
    "requirements": {
      "builtin_object_not_overridden": true,
      "no_proxy_constructor_interposition": true
    }
  },
  "target": {
    "kind": "helper",
    "template": "JsObject.ToObjectOrCreate($value)",
    "helper": "JsObject.ToObjectOrCreate"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "object_input": "returns the same object identity",
    "null_or_undefined": "creates a new ordinary object",
    "primitive_input": "creates the corresponding wrapper object",
    "mutation": false
  },
  "caveats": [
    "C# new object() is not equivalent for primitive or object inputs.",
    "Wrapper objects must preserve JavaScript boxed-primitive behavior."
  ],
  "references": [
    "ECMAScript 2026 §20.1.1 Object Constructor"
  ],
  "tests": [
    {
      "name": "object identity preserved",
      "input": "const x={a:1}; console.log(Object(x)===x);",
      "expected_behavior": "prints true"
    },
    {
      "name": "null creates ordinary object",
      "input": "const x=Object(null); console.log(typeof x, Object.getPrototypeOf(x)===Object.prototype);",
      "expected_behavior": "prints object true"
    }
  ]
}
