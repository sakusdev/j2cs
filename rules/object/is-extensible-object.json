{
  "id": "object.is-extensible.object",
  "category": "object",
  "summary": "Preserve Object.isExtensible for object receivers including descriptor/proxy semantics.",
  "source": {
    "pattern": "Object.isExtensible($obj)",
    "requirements": {
      "builtin_not_overridden": true,
      "receiver_static_type": "Object"
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.ObjectIsExtensible($obj)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "receiver": "object",
    "result": "boolean",
    "proxy": "corresponding internal method/traps may run",
    "integrity_check": "own property descriptors and extensibility are consulted where required"
  },
  "caveats": [
    "Cannot be inferred from C# mutability or class metadata."
  ],
  "references": [
    "ECMAScript 2026 Object.isExtensible"
  ],
  "tests": [
    {
      "name": "ordinary object state",
      "input": "const x={}; console.log(Object.isExtensible(x));",
      "expected_behavior": "prints true for a fresh ordinary object"
    },
    {
      "name": "after integrity operation",
      "input": "const x={}; Object.preventExtensions(x); console.log(Object.isExtensible(x));",
      "expected_behavior": "prints false"
    }
  ]
}
