{
  "id": "object.prototype.is-prototype-of",
  "category": "object",
  "summary": "Walk the target's dynamic [[Prototype]] chain using Object.prototype.isPrototypeOf semantics.",
  "source": {
    "pattern": "$proto.isPrototypeOf($value)",
    "requirements": {
      "receiver_method_resolves_to_builtin_Object_prototype_isPrototypeOf": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.IsPrototypeOf($proto, $value)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "value_non_object": "returns false before coercing this",
    "this": "ToObject(this) when value is object",
    "prototype_walk": "repeated [[GetPrototypeOf]] identity comparison"
  },
  "caveats": [
    "Proxy getPrototypeOf traps can execute during the walk.",
    "C# Type.IsAssignableFrom is not equivalent to per-instance prototype membership."
  ],
  "references": [
    "ECMAScript 2026 §20.1.3.3 Object.prototype.isPrototypeOf"
  ],
  "tests": [
    {
      "name": "prototype found",
      "input": "const p={},x=Object.create(p); console.log(p.isPrototypeOf(x));",
      "expected_behavior": "prints true"
    },
    {
      "name": "primitive target false",
      "input": "console.log(({}).isPrototypeOf(1));",
      "expected_behavior": "prints false"
    }
  ]
}
