{"id":"modules.cjs.module-exports-assignment","category":"modules","summary":"Replace the CommonJS exported value when assigning module.exports.","source":{"pattern":"module.exports = $value","requirements":{"host":"Node.js","module_system":"CommonJS","module_binding_is_builtin_wrapper_parameter":true}},"target":{"kind":"helper","template":"JsCommonJsRuntime.SetModuleExports($context, $value)","helper":"JsCommonJsRuntime.SetModuleExports","notes":"module.exports may be any JavaScript value; later require calls return it."},"strategy":"helper","confidence":"high","semantics":{"mutation":"replaces module.exports","exports_alias":"does not automatically rebind the local exports variable"},"caveats":["Do not model module.exports and exports as permanently linked variables."],"references":["Node.js Modules: CommonJS modules"],"tests":[{"name":"replacement object returned","input":"// a.cjs: module.exports={x:1}\n// main.cjs: console.log(require('./a').x);","expected_csharp":"JsCommonJsRuntime.SetModuleExports(context, value);","expected_behavior":"prints 1"},{"name":"primitive replacement allowed","input":"// a.cjs: module.exports='ok'\n// main.cjs: console.log(require('./a'));","expected_behavior":"prints ok"}]}