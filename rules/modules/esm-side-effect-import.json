{"id":"modules.esm.side-effect-import","category":"modules","summary":"Evaluate a side-effect-only ESM dependency through module-graph ordering and exactly-once evaluation.","source":{"pattern":"import $specifier","requirements":{"source_type":"ECMAScript module","import_clause_absent":true}},"target":{"kind":"runtime","template":"JsModuleRuntime.RequireDependency($module, $specifier)","notes":"Resolve/link the dependency before evaluation and execute it before the importer body for synchronous graphs."},"strategy":"runtime","confidence":"high","semantics":{"binding_created":false,"evaluation":"normal ESM graph evaluation","once":"same Module Record executes once"},"caveats":["Do not emit an arbitrary call at the textual import position; imports are linked before body evaluation."],"references":["ECMAScript 2026 §16.2 Modules"],"tests":[{"name":"dependency executes first","input":"// dep.mjs: console.log('dep')\n// main.mjs: console.log('main'); import './dep.mjs';","expected_behavior":"prints dep then main"},{"name":"duplicate side-effect imports execute once","input":"// dep.mjs: console.log('once')\n// main.mjs: import './dep.mjs'; import './dep.mjs';","expected_behavior":"prints once exactly once"}]}