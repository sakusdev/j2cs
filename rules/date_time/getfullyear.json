{
  "id": "date.prototype.getfullyear",
  "category": "date_time",
  "summary": "getFullYear reads full local year after converting the Date time value through host local-time rules; Invalid Date returns NaN.",
  "source": {
    "pattern": "$date.getFullYear()",
    "requirements": {
      "receiver_has_date_value_internal_slot": true,
      "property_lookup_resolves_builtin": "Date.prototype.getFullYear"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsDate.getFullYear",
    "template": "JsDate.getFullYear($date)",
    "notes": "LocalTime conversion must use the host time-zone rules applicable to that instant, including historical/DST transitions."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "receiver_mutated": false,
    "invalid_date": "NaN",
    "timezone": "host local",
    "operation": "YearFromTime"
  },
  "caveats": [],
  "references": [
    "https://tc39.es/ecma262/multipage/numbers-and-dates.html#sec-date-objects",
    "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date"
  ],
  "tests": [
    {
      "name": "valid local component",
      "input": "const d=new Date(2024,0,15,12); console.log(d.getFullYear());",
      "expected_behavior": "prints 2024"
    },
    {
      "name": "invalid Date returns NaN",
      "input": "console.log(Number.isNaN(new Date(NaN).getFullYear()));",
      "expected_behavior": "prints true"
    }
  ]
}
