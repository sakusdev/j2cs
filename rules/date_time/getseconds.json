{
  "id": "date.prototype.getseconds",
  "category": "date_time",
  "summary": "getSeconds reads local seconds 0..59 after converting the Date time value through host local-time rules; Invalid Date returns NaN.",
  "source": {
    "pattern": "$date.getSeconds()",
    "requirements": {
      "receiver_has_date_value_internal_slot": true,
      "property_lookup_resolves_builtin": "Date.prototype.getSeconds"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsDate.getSeconds",
    "template": "JsDate.getSeconds($date)",
    "notes": "LocalTime conversion must use the host time-zone rules applicable to that instant, including historical/DST transitions."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "receiver_mutated": false,
    "invalid_date": "NaN",
    "timezone": "host local",
    "operation": "SecFromTime"
  },
  "caveats": [],
  "references": [
    "https://tc39.es/ecma262/multipage/numbers-and-dates.html#sec-date-objects",
    "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date"
  ],
  "tests": [
    {
      "name": "valid local component",
      "input": "const d=new Date(2024,0,15,13,4,37); console.log(d.getSeconds());",
      "expected_behavior": "prints 37"
    },
    {
      "name": "invalid Date returns NaN",
      "input": "console.log(Number.isNaN(new Date(NaN).getSeconds()));",
      "expected_behavior": "prints true"
    }
  ]
}
