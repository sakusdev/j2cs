{
  "id": "coercion.to-uint32.number",
  "category": "coercion",
  "summary": "ToUint32 applies ECMAScript truncation and modulo-2^32 integer conversion.",
  "source": {
    "pattern": "[[ToUint32]]($number)",
    "requirements": {
      "semantic_operation": "ToUint32",
      "input_already_number": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsCoercion.ToUint32",
    "template": "JsCoercion.ToUint32($number)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "nan_infinity_zero": "+0",
    "fraction": "truncate toward zero",
    "bits": 32,
    "signed": false,
    "wraps_modulo": 4294967296
  },
  "tests": [
    {
      "name": "wraps at width",
      "input": "// semantic IR: ToUint32(-1)",
      "expected_behavior": "returns 4294967295"
    },
    {
      "name": "NaN maps to zero",
      "input": "// semantic IR: ToUint32(NaN)",
      "expected_behavior": "returns +0"
    }
  ],
  "caveats": [
    "A checked C# cast is not equivalent; unchecked casts also differ for NaN/infinity and must not be assumed portable for JS semantics."
  ],
  "references": [
    "ECMAScript Language Specification, Type Conversion abstract operations (living specification)"
  ]
}
