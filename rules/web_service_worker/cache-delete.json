{
  "id": "web.cache.delete",
  "category": "web_service_worker",
  "summary": "Delete all cache entries matching RequestInfo/options and resolve whether anything was removed.",
  "source": {
    "pattern": "$cache.delete($request, $options)",
    "requirements": {
      "receiver_is_intrinsic_cache": true,
      "builtin_not_overridden": true,
      "secure_context": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.WebCacheDelete",
    "template": "JsRuntime.WebCacheDelete($cache, $request, $options)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return": "Promise<Boolean>",
    "false": "no matching entry",
    "true": "one or more matching entries removed",
    "options": "ignoreSearch/ignoreMethod/ignoreVary affect match set"
  },
  "references": [
    "https://w3c.github.io/ServiceWorker/"
  ],
  "tests": [
    {
      "name": "delete found",
      "input": "// after put /a: await cache.delete('/a')",
      "expected_behavior": "resolves true"
    },
    {
      "name": "delete missing",
      "input": "// await cache.delete('/none')",
      "expected_behavior": "resolves false"
    }
  ]
}
