{
  "id": "error.aggregate.errors-descriptor",
  "category": "errors",
  "summary": "Preserve AggregateError's own errors property as a new ordinary Array with a non-enumerable data descriptor.",
  "source": {
    "pattern": "new AggregateError($errors).errors",
    "requirements": {
      "builtin_AggregateError_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.CreateAggregateError",
    "template": "JsRuntime.CreateAggregateError($errors, JsUndefined.Value, JsUndefined.Value, $newTarget)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "value": "fresh Array containing iterated values in order",
    "descriptor": {
      "writable": true,
      "enumerable": false,
      "configurable": true
    },
    "identity": "the source iterable/container is not reused as the errors array"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/fundamental-objects.html#sec-error-objects"
  ],
  "tests": [
    {
      "name": "array copied",
      "input": "const a=[1]; const e=new AggregateError(a); console.log(e.errors===a,e.errors[0])",
      "expected_behavior": "prints false 1"
    },
    {
      "name": "descriptor flags",
      "input": "const d=Object.getOwnPropertyDescriptor(new AggregateError([]),'errors'); console.log(d.writable,d.enumerable,d.configurable)",
      "expected_behavior": "prints true false true"
    }
  ]
}
