{
  "id": "weakref.constructor.requires-new",
  "category": "weakref_finalization",
  "summary": "WeakRef requires construction with new.",
  "source": {
    "pattern": "WeakRef($target)",
    "requirements": {
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.WeakMemory",
    "template": "JsRuntime.WeakMemory.weakref_constructor_requires_new($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "new_target": "undefined throws TypeError before target validation"
  },
  "caveats": [],
  "references": [
    "https://tc39.es/ecma262/2026/multipage/managing-memory.html"
  ],
  "tests": [
    {
      "name": "call without new",
      "input": "try{WeakRef({})}catch(e){console.log(e instanceof TypeError)}",
      "expected_behavior": "prints true"
    },
    {
      "name": "new succeeds",
      "input": "const x={}; console.log(new WeakRef(x).deref()===x)",
      "expected_behavior": "prints true"
    }
  ]
}
