{
  "id": "structured-clone.custom-prototype",
  "category": "workers_messaging",
  "summary": "Deserialize ordinary objects without preserving arbitrary custom prototype identity.",
  "source": {
    "pattern": "[[StructuredDeserialize]]($ordinaryObjectRecord)",
    "requirements": {
      "serialized_kind": "ordinary object"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWorkersMessaging.structured_clone_custom_prototype",
    "template": "JsWorkersMessaging.structured_clone_custom_prototype($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "custom_prototype_identity": "not preserved",
    "target_realm_ordinary_prototype": true
  },
  "references": [
    "https://html.spec.whatwg.org/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "custom proto",
      "input": "const p={m(){return 1}},x=Object.create(p);x.a=2;const y=structuredClone(x);console.log(y.a,typeof y.m);",
      "expected_behavior": "prints 2 undefined"
    },
    {
      "name": "plain proto",
      "input": "const y=structuredClone({a:1});console.log(Object.getPrototypeOf(y)===Object.prototype);",
      "expected_behavior": "prints true in same realm"
    }
  ]
}
