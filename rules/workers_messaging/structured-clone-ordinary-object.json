{
  "id": "structured-clone.ordinary-object",
  "category": "workers_messaging",
  "summary": "Serialize ordinary object properties with observable access semantics.",
  "source": {
    "pattern": "[[StructuredSerialize]]($object)",
    "requirements": {
      "semantic_operation": "StructuredSerialize",
      "input": "ordinary object"
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.WorkersMessaging.structured_clone_ordinary_object",
    "template": "JsRuntime.WorkersMessaging.structured_clone_ordinary_object($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "getters": "may execute",
    "custom_descriptors": "not generally preserved",
    "abrupt_completion": "propagates"
  },
  "references": [
    "https://html.spec.whatwg.org/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "getter",
      "input": "let n=0;const y=structuredClone({get x(){n++;return 3}});console.log(n,y.x);",
      "expected_behavior": "prints 1 3"
    },
    {
      "name": "throwing getter",
      "input": "try{structuredClone({get x(){throw 7}})}catch(e){console.log(e)}",
      "expected_behavior": "prints 7"
    }
  ]
}
