{
  "id": "atomics.wait-async-int32",
  "category": "atomics_shared_memory",
  "summary": "Atomics.waitAsync on shared Int32Array uses the same waiter-list/value semantics without synchronously suspending the calling agent.",
  "source": {
    "pattern": "Atomics.waitAsync($int32,$index,$expected,$timeout?)",
    "requirements": {
      "typed_array": "Int32Array",
      "backing": "SharedArrayBuffer"
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.Atomics.wait_async_int32",
    "template": "JsRuntime.Atomics.wait_async_int32($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "expected": "ToInt32",
    "caller_suspend": false,
    "return": "{async,value}",
    "waiter": "Promise-based when asynchronous"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "not equal sync object",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=1;console.log(JSON.stringify(Atomics.waitAsync(a,0,0,100)));",
      "expected_behavior": "prints {\"async\":false,\"value\":\"not-equal\"}"
    },
    {
      "name": "matching positive timeout",
      "input": "const r=Atomics.waitAsync(new Int32Array(new SharedArrayBuffer(4)),0,0,10);console.log(r.async, r.value instanceof Promise);",
      "expected_behavior": "prints true true"
    }
  ]
}
