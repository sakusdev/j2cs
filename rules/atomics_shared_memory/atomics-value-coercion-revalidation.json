{
  "id": "atomics.value-coercion-revalidation",
  "category": "atomics_shared_memory",
  "summary": "Revalidate atomic access after value coercion because user code can mutate resizable/growable buffer bounds before the memory operation.",
  "source": {
    "pattern": "Atomics.$rmwOrStore($ta,$index,$value)",
    "requirements": {
      "value_coercion_may_execute_user_code": true,
      "resizable_or_growable_buffer_possible": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.Atomics.value_coercion_revalidation",
    "template": "JsRuntime.Atomics.value_coercion_revalidation($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "initial_validation": "before value coercion",
    "coercion": "observable user code",
    "revalidation": "after coercion before memory event",
    "stale_access_forbidden": true
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "observable coercion",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));let n=0;Atomics.store(a,0,{valueOf(){n++;return 1}});console.log(n);",
      "expected_behavior": "prints 1"
    },
    {
      "name": "revalidation contract",
      "input": "// semantic IR: valueOf changes backing bounds between validation and operation",
      "expected_behavior": "translator must revalidate before atomic access"
    }
  ]
}
