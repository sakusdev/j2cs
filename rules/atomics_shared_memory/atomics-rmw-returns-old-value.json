{
  "id": "atomics.rmw-returns-old-value",
  "category": "atomics_shared_memory",
  "summary": "All Atomics read-modify-write operations return the value read before modification, not the newly stored value.",
  "source": {
    "pattern": "[[AtomicReadModifyWrite]]($ta,$index,$value,$op)",
    "requirements": {
      "semantic_operation": "AtomicReadModifyWrite"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsAtomics.rmw_returns_old_value",
    "template": "JsAtomics.rmw_returns_old_value($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return": "old element value",
    "mutation": "new value written atomically",
    "applies_to": "add/sub/and/or/xor/exchange"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "add old",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=3;console.log(Atomics.add(a,0,2),a[0]);",
      "expected_behavior": "prints 3 5"
    },
    {
      "name": "exchange old",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=4;console.log(Atomics.exchange(a,0,8),a[0]);",
      "expected_behavior": "prints 4 8"
    }
  ]
}
