{
  "id": "atomics.wait-undefined-timeout",
  "category": "atomics_shared_memory",
  "summary": "Treat omitted/undefined Atomics.wait timeout as an infinite wait after ToNumber(undefined) yields NaN.",
  "source": {
    "pattern": "Atomics.wait($ta,$index,$expected)",
    "requirements": {
      "waitable_shared_typed_array": true,
      "current_value_matches": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.Atomics.wait_undefined_timeout",
    "template": "JsRuntime.Atomics.wait_undefined_timeout($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "timeout": "undefined -> NaN -> +Infinity",
    "blocking": "continues until notify/spurious host termination is not a JS result",
    "result": "ok when notified"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "semantic timeout",
      "input": "// worker: Atomics.wait(sharedInt32,0,0)",
      "expected_behavior": "has no finite ECMAScript timeout by default"
    },
    {
      "name": "explicit Infinity",
      "input": "// worker: Atomics.wait(sharedInt32,0,0,Infinity)",
      "expected_behavior": "same infinite-timeout class"
    }
  ]
}
