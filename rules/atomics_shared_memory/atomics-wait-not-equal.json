{
  "id": "atomics.wait-not-equal",
  "category": "atomics_shared_memory",
  "summary": "Return not-equal immediately when the seq-cst loaded wait location differs from the coerced expected value.",
  "source": {
    "pattern": "Atomics.wait($ta,$index,$expected,$timeout?)",
    "requirements": {
      "waitable_shared_typed_array": true,
      "current_value_differs": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.Atomics.wait_not_equal",
    "template": "JsRuntime.Atomics.wait_not_equal($args)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "result": "not-equal",
    "blocking": false,
    "waiter_added": false,
    "load_order": "seq-cst"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "Int32 mismatch",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=2;console.log(Atomics.wait(a,0,1,1000));",
      "expected_behavior": "prints not-equal immediately"
    },
    {
      "name": "timeout irrelevant on mismatch",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=2;console.log(Atomics.wait(a,0,1,Infinity));",
      "expected_behavior": "prints not-equal"
    }
  ]
}
