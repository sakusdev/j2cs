{
  "id": "atomics.element-width-wrapping",
  "category": "atomics_shared_memory",
  "summary": "Convert operands/results through the typed array element width; atomic arithmetic is not arbitrary-width Number/BigInt storage.",
  "source": {
    "pattern": "[[AtomicElementWidthConversion]]($ta,$numeric)",
    "requirements": {
      "semantic_operation": "Atomics element byte conversion"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsAtomics.element_width_wrapping",
    "template": "JsAtomics.element_width_wrapping($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "signed_unsigned": "typed-array element semantics",
    "wrap": "modulo element width as NumericToRawBytes dictates",
    "return_old": "decoded old element uses element type"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "Uint8 add wrap",
      "input": "const a=new Uint8Array(new SharedArrayBuffer(1));a[0]=255;Atomics.add(a,0,1);console.log(a[0]);",
      "expected_behavior": "prints 0"
    },
    {
      "name": "Int8 signed decode",
      "input": "const a=new Int8Array(new SharedArrayBuffer(1));a[0]=127;console.log(Atomics.add(a,0,1),a[0]);",
      "expected_behavior": "prints 127 -128"
    }
  ]
}
