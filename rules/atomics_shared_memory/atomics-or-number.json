{
  "id": "atomics.or-number",
  "category": "atomics_shared_memory",
  "summary": "Atomically bitwise-OR Number integer storage and return the old value.",
  "source": {
    "pattern": "Atomics.or($ta,$index,$value)",
    "requirements": {
      "content_type": "Number"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsAtomics.or_number",
    "template": "JsAtomics.or_number($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "value_conversion": "ToIntegerOrInfinity",
    "return": "old element",
    "update": "bytewise atomic OR"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "or",
      "input": "const a=new Uint8Array(new SharedArrayBuffer(1));a[0]=8;console.log(Atomics.or(a,0,3),a[0]);",
      "expected_behavior": "prints 8 11"
    },
    {
      "name": "return old",
      "input": "const a=new Int32Array(new SharedArrayBuffer(4));a[0]=1;console.log(Atomics.or(a,0,2));",
      "expected_behavior": "prints 1"
    }
  ]
}
