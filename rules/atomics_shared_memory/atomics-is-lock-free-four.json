{
  "id": "atomics.is-lock-free-four",
  "category": "atomics_shared_memory",
  "summary": "Atomics.isLockFree(4) is specified to return true on all conforming implementations.",
  "source": {
    "pattern": "Atomics.isLockFree(4)",
    "requirements": {
      "constant_size": 4
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsAtomics.is_lock_free_four",
    "template": "JsAtomics.is_lock_free_four($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return": true,
    "reason": "ECMAScript guarantee",
    "hardware_abstraction": "implementation must support lock-free 4-byte atomic primitive"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/structured-data.html"
  ],
  "tests": [
    {
      "name": "four",
      "input": "console.log(Atomics.isLockFree(4));",
      "expected_behavior": "prints true"
    },
    {
      "name": "not generalize eight",
      "input": "console.log(typeof Atomics.isLockFree(8));",
      "expected_behavior": "prints boolean; value for 8 is agent-dependent"
    }
  ]
