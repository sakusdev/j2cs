{
  "id": "node.child-process.stdout",
  "category": "node_process_workers",
  "summary": "Expose child.stdout as the configured Readable pipe or null, reusing stream semantics.",
  "source": {
    "pattern": "$child.stdout",
    "requirements": {
      "receiver": "ChildProcess",
      "builtin_property": "stdout"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeProcessWorkers.node_child_process_stdout",
    "template": "NodeProcessWorkers.node_child_process_stdout($args)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "pipe": "Readable stream",
    "non_pipe": "null or mapped handle",
    "owner": "EVENTS_STREAMS"
  },
  "references": [
    "https://nodejs.org/api/child_process.html"
  ],
  "tests": [
    {
      "name": "default",
      "input": "const {spawn}=require('node:child_process');const c=spawn(process.execPath,['-e','']);console.log(c.stdout!==null);c.kill();",
      "expected_behavior": "prints true"
    },
    {
      "name": "inherit",
      "input": "const {spawn}=require('node:child_process');const c=spawn(process.execPath,['-e',''],{stdio:'inherit'});console.log(c.stdout===null);",
      "expected_behavior": "prints true"
    }
  ]
}
