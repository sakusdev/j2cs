{
  "id": "electron.protocol.privilege-code-cache",
  "category": "electron_net_protocol",
  "summary": "Enable V8 code cache only in combination with standard scheme privilege.",
  "source": {
    "pattern": "protocol.registerSchemesAsPrivileged([{scheme:$scheme, privileges:{codeCache:true, standard:$standard,...$p}}])",
    "requirements": {
      "electron_app_profile": "current Electron",
      "builtin_electron_member_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.Protocol.RegisterCodeCacheScheme",
    "template": "ElectronCompat.Protocol.RegisterCodeCacheScheme($scheme, $standard, $p)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "codeCache": true,
    "requires_standard": true
  },
  "caveats": [
    "codeCache:true without standard:true does not establish working code-cache semantics."
  ],
  "references": [
    "Electron latest protocol documentation"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "/* standard:true,codeCache:true */",
      "expected_behavior": "custom scheme can use V8 code cache"
    },
    {
      "name": "semantic trap",
      "input": "/* codeCache:true,standard:false */",
      "expected_behavior": "must not claim code cache is enabled"
    }
  ]
}
