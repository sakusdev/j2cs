{
  "id": "electron.net.request-credentials",
  "category": "electron_net_protocol",
  "summary": "Apply Fetch-like credentials policy to Chromium ClientRequest.",
  "source": {
    "pattern": "net.request({credentials:$credentials, ...$rest})",
    "requirements": {
      "electron_app_profile": "current Electron",
      "builtin_electron_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.ElectronNetRequest($options)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "values": [
      "include",
      "omit",
      "same-origin"
    ],
    "include": "session credentials used",
    "omit": "credentials omitted and 401 login event suppressed",
    "same_origin": "requires origin context"
  },
  "caveats": [
    "Credentials policy is not equivalent to useSessionCookies."
  ],
  "references": [
    "Electron latest net / ClientRequest / IncomingMessage documentation"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "/* credentials:'omit' */",
      "expected_behavior": "session credentials are not sent"
    },
    {
      "name": "semantic trap",
      "input": "/* 401 with credentials:'omit' */",
      "expected_behavior": "login event is not triggered"
    }
  ]
}
