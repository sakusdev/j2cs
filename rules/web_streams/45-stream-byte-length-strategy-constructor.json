{
  "id": "web.stream.byte-length-strategy.constructor",
  "category": "web_streams",
  "summary": "Create a byteLength-based queuing strategy.",
  "source": {
    "pattern": "new ByteLengthQueuingStrategy({highWaterMark:$hwm})",
    "requirements": {
      "intrinsic_web_stream_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebStreams.ByteLengthStrategyCreate",
    "template": "JsWebStreams.ByteLengthStrategyCreate(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "normal": "stores the validated highWaterMark",
    "edge": "missing/invalid highWaterMark preserves Web IDL conversion/errors"
  },
  "caveats": [],
  "references": [
    "https://streams.spec.whatwg.org/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "new ByteLengthQueuingStrategy({highWaterMark:1024})",
      "expected_behavior": "stores the validated highWaterMark"
    },
    {
      "name": "edge semantics",
      "input": "new ByteLengthQueuingStrategy({})",
      "expected_behavior": "missing/invalid highWaterMark preserves Web IDL conversion/errors"
    }
  ]
}
