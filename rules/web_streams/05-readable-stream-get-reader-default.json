{
  "id": "web.readable-stream.get-reader.default",
  "category": "web_streams",
  "summary": "Acquire an exclusive default reader.",
  "source": {
    "pattern": "$stream.getReader()",
    "requirements": {
      "intrinsic_web_stream_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebStreams.GetDefaultReader",
    "template": "JsWebStreams.GetDefaultReader(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "normal": "locks the stream and returns a default reader",
    "edge": "throws TypeError if the stream is already locked"
  },
  "caveats": [],
  "references": [
    "https://streams.spec.whatwg.org/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "new ReadableStream().getReader()",
      "expected_behavior": "locks the stream and returns a default reader"
    },
    {
      "name": "edge semantics",
      "input": "(()=>{const s=new ReadableStream();s.getReader();return s.getReader()})()",
      "expected_behavior": "throws TypeError if the stream is already locked"
    }
  ]
}
