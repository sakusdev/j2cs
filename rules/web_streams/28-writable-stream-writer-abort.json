{
  "id": "web.writable-stream.writer.abort",
  "category": "web_streams",
  "summary": "Abort through the owning writer.",
  "source": {
    "pattern": "$writer.abort($reason?)",
    "requirements": {
      "intrinsic_web_stream_api": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsWebStreams.WriterAbort",
    "template": "JsWebStreams.WriterAbort(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "normal": "forwards the reason and returns a promise",
    "edge": "released writers reject with TypeError"
  },
  "caveats": [],
  "references": [
    "https://streams.spec.whatwg.org/"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "new WritableStream().getWriter().abort('x')",
      "expected_behavior": "forwards the reason and returns a promise"
    },
    {
      "name": "edge semantics",
      "input": "(()=>{const w=new WritableStream().getWriter();w.releaseLock();return w.abort()})()",
      "expected_behavior": "released writers reject with TypeError"
    }
  ]
}
