  "summary": "Lower intrinsic Promise.allSettled to ordered fulfillment/rejection records without rejecting merely because an input promise rejects.",
  "source": {"pattern": "Promise.allSettled($iterable)", "requirements": {"constructor": "intrinsic Promise", "method_not_overridden": true, "promise_resolve_not_overridden": true, "iterable": "supported compiled JS iterable"}},
  "target": {"kind": "helper", "helper": "JsPromise.AllSettled", "template": "JsPromise.AllSettled($iterable)", "notes": "Produce JS-shaped {status,value} or {status,reason} objects in input order."},
  "strategy": "helper",
  "confidence": "high",
  "semantics": {"result_order": "input iteration order", "element_rejection": "recorded, not aggregate rejection", "fulfilled_record": "status fulfilled plus value", "rejected_record": "status rejected plus reason", "empty": "fulfilled with empty array"},
  "caveats": ["The aggregate can still reject for abrupt iterator/constructor/Promise.resolve operations."],
  "references": ["ECMAScript 2026 Promise.allSettled"],
  "tests": [
