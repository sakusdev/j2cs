{"id":"dom.node.text-content-set","category":"dom_renderer","summary":"Set Node.textContent using DOM's null-to-empty behavior and node-type-specific replacement semantics.","source":{"pattern":"$node.textContent = $value","requirements":{"receiver":"Node","webidl_attribute_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.SetTextContent($node, $value)"},"strategy":"helper","confidence":"high","semantics":{"null":"acts as empty string","Element_or_DocumentFragment":"replace all children with one Text node unless string is empty, in which case no child","CharacterData":"replace data","Document_or_DocumentType":"no effect"},"caveats":["C# null-to-string conversion is not the DOM rule; null specifically becomes empty string here."],"references":["WHATWG DOM Living Standard § Node.textContent"],"tests":[{"name":"replaces children with text","input":"const e=document.createElement('div'); e.append(document.createElement('i')); e.textContent='x'; console.log(e.childNodes.length,e.firstChild.nodeType,e.textContent);","expected_behavior":"prints 1 3 x"},{"name":"null empties element","input":"const e=document.createElement('div'); e.textContent='x'; e.textContent=null; console.log(e.childNodes.length,e.textContent==='');","expected_behavior":"prints 0 true"}]}