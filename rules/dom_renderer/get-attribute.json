{"id":"dom.element.get-attribute","category":"dom_renderer","summary":"Read an attribute value, including HTML ASCII-lowercasing of the requested name and null for absence.","source":{"pattern":"$element.getAttribute($name)","requirements":{"receiver":"Element","builtin_not_overridden":true}},"target":{"kind":"helper","template":"NativeDom.GetAttribute($element, JsCoercion.ToString($name))"},"strategy":"helper","confidence":"high","semantics":{"name":"HTML namespace elements in HTML documents ASCII-lowercase qualifiedName","return_value":"attribute string value or null","conversion":"DOMString conversion before lookup"},"caveats":["Do not conflate absent with empty-string attributes."],"references":["WHATWG DOM Living Standard § Element.getAttribute"],"tests":[{"name":"absent returns null","input":"const e=document.createElement('div'); console.log(e.getAttribute('x')===null);","expected_behavior":"prints true"},{"name":"HTML name lookup lowercases","input":"const e=document.createElement('div'); e.setAttribute('DATA-X','v'); console.log(e.getAttribute('data-x'));","expected_behavior":"prints v"}]}