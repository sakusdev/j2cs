{"id":"dom.node.text-content-get","category":"dom_renderer","summary":"Read Node.textContent with node-type-specific null/string behavior and descendant-text concatenation.","source":{"pattern":"$node.textContent","requirements":{"receiver":"Node","webidl_attribute_not_overridden":true,"native_dom_tree":true}},"target":{"kind":"helper","template":"NativeDom.GetTextContent($node)"},"strategy":"helper","confidence":"high","semantics":{"Document_or_DocumentType":"null","Element_or_DocumentFragment":"concatenate descendant Text data in tree order, excluding comments/processing instructions","CharacterData":"node data","return_type":"string or null"},"caveats":["innerText is not equivalent; textContent does not perform layout/style filtering."],"references":["WHATWG DOM Living Standard § Node.textContent"],"tests":[{"name":"element concatenates descendant text","input":"const e=document.createElement('div'); e.innerHTML='a<span>b</span><!--c-->'; console.log(e.textContent);","expected_behavior":"prints ab"},{"name":"document returns null","input":"console.log(document.textContent===null);","expected_behavior":"prints true"}]}