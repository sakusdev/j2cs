{"id":"dom.document.get-element-by-id","category":"dom_renderer","summary":"Look up the first tree-ordered element with an exactly matching ID in the document.","source":{"pattern":"$document.getElementById($id)","requirements":{"receiver":"Document","builtin_not_overridden":true,"native_dom_tree":true}},"target":{"kind":"helper","template":"NativeDom.GetElementById($document, JsCoercion.ToString($id))"},"strategy":"helper","confidence":"high","semantics":{"matching":"exact ID value match","duplicates":"first matching element in tree order","return_value":"Element or null","conversion":"argument uses DOMString conversion"},"caveats":["A Dictionary<string,Element> is only safe if it tracks duplicate IDs and tree-order changes correctly."],"references":["WHATWG DOM Living Standard § NonElementParentNode.getElementById"],"tests":[{"name":"finds matching id","input":"document.body.innerHTML='<p id=\"x\"></p>'; console.log(document.getElementById('x').tagName);","expected_behavior":"prints P"},{"name":"duplicate ids use first in tree order","input":"document.body.innerHTML='<i id=\"x\"></i><b id=\"x\"></b>'; console.log(document.getElementById('x').tagName);","expected_behavior":"prints I"}]}