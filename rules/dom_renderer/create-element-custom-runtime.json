{"id":"dom.document.create-element-custom-runtime","category":"dom_renderer","summary":"Use retained DOM/custom-elements runtime when createElement can interact with custom element registries or options.","source":{"pattern":"$document.createElement($localName, $options)","requirements":{"receiver":"Document","custom_element_behavior_may_be_observable":true}},"target":{"kind":"runtime","template":"JsRuntime.DomCreateElement($document, $localName, $options)"},"strategy":"runtime","confidence":"high","semantics":{"custom_elements":"registry lookup, construction, reactions, and customized built-ins are observable","options":"is/customElementRegistry behavior must be preserved","exceptions":"NotSupportedError/InvalidCharacterError as specified"},"caveats":["Do not lower unknown hyphenated names to inert backend nodes when a custom registry is observable."],"references":["WHATWG DOM Living Standard § Document.createElement","WHATWG HTML Custom Elements"],"tests":[{"name":"custom element constructor can run","input":"customElements.define('x-a',class extends HTMLElement{constructor(){super();console.log('ctor')}}); document.createElement('x-a');","expected_behavior":"prints ctor"},{"name":"invalid element name throws","input":"try{document.createElement('a b')}catch(e){console.log(e.name)}","expected_behavior":"prints InvalidCharacterError"}]}