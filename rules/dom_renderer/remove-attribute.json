{"id":"dom.element.remove-attribute","category":"dom_renderer","summary":"Remove an attribute with HTML name normalization; absence is a no-op and return value is undefined.","source":{"pattern":"$element.removeAttribute($name)","requirements":{"receiver":"Element","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"trusted_types_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.RemoveAttribute($element, JsCoercion.ToString($name))"},"strategy":"helper","confidence":"high","semantics":{"return_value":"undefined","absent":"no-op","name_normalization":"ASCII-lowercase for HTML namespace elements in HTML documents"},"caveats":["Attribute mutation observers/custom-element reactions are excluded by this specialization."],"references":["WHATWG DOM Living Standard § Element.removeAttribute"],"tests":[{"name":"removes present attribute","input":"const e=document.createElement('div'); e.setAttribute('x','1'); console.log(e.removeAttribute('x')===undefined,e.hasAttribute('x'));","expected_behavior":"prints true false"},{"name":"absent is no-op","input":"const e=document.createElement('div'); console.log(e.removeAttribute('missing')===undefined);","expected_behavior":"prints true"}]}