{"id":"dom.event.prevent-default","category":"dom_renderer","summary":"Set the canceled flag only when the Event is cancelable and the current listener is not passive.","source":{"pattern":"$event.preventDefault()","requirements":{"receiver":"Event","builtin_not_overridden":true,"native_event_subsystem":true}},"target":{"kind":"helper","template":"NativeDom.PreventDefault($event)"},"strategy":"helper","confidence":"high","semantics":{"return_value":"undefined","cancelable_false":"no effect","passive_listener":"no cancelation when passive","default_prevented":"reflects canceled flag"},"caveats":["C# cancellation tokens are not equivalent; this mutates DOM event dispatch state."],"references":["WHATWG DOM Living Standard § Event.preventDefault"],"tests":[{"name":"cancelable event becomes prevented","input":"const e=new Event('x',{cancelable:true}); e.preventDefault(); console.log(e.defaultPrevented);","expected_behavior":"prints true"},{"name":"non-cancelable event ignores call","input":"const e=new Event('x'); e.preventDefault(); console.log(e.defaultPrevented);","expected_behavior":"prints false"}]}