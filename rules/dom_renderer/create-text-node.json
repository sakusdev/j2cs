{"id":"dom.document.create-text-node","category":"dom_renderer","summary":"Create a detached Text node while preserving Web IDL string conversion and UTF-16 contents.","source":{"pattern":"$document.createTextNode($data)","requirements":{"receiver":"Document","builtin_not_overridden":true}},"target":{"kind":"helper","template":"NativeDom.CreateTextNode($document, JsCoercion.ToString($data))"},"strategy":"helper","confidence":"high","semantics":{"conversion":"argument converted to DOMString/string before node creation","return_value":"fresh detached Text node","utf16":"preserve JavaScript string UTF-16 code units","owner_document":"result belongs to receiver document"},"caveats":["Reuse existing JsCoercion.ToString semantics rather than C# ToString culture formatting."],"references":["WHATWG DOM Living Standard § Document.createTextNode","Web IDL string conversion"],"tests":[{"name":"creates text node","input":"const t=document.createTextNode('a<b'); console.log(t.nodeType,t.data,t.parentNode===null);","expected_behavior":"prints 3 a<b true"},{"name":"coerces non-string","input":"console.log(document.createTextNode(42).data);","expected_behavior":"prints 42"}]}