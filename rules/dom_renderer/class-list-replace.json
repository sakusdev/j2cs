{"id":"dom.domtokenlist.replace","category":"dom_renderer","summary":"Replace a class token while preserving position, validation, deduplication, and boolean return.","source":{"pattern":"$classList.replace($token, $newToken)","requirements":{"receiver":"Element.classList DOMTokenList","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.ClassListReplace($classList, $token, $newToken)"},"strategy":"helper","confidence":"high","semantics":{"return_value":"false if old token absent; true if replacement operation applies","position":"replacement occupies old token's position unless new token already present per DOM algorithm","validation":"both tokens validated before mutation"},"caveats":["A set-only representation can lose observable token order/stringification."],"references":["WHATWG DOM Living Standard § DOMTokenList.replace"],"tests":[{"name":"replaces present token","input":"const e=document.createElement('div'); e.className='a b'; console.log(e.classList.replace('a','c'),e.className);","expected_behavior":"prints true c b"},{"name":"absent old token returns false","input":"const e=document.createElement('div'); e.className='a'; console.log(e.classList.replace('x','y'),e.className);","expected_behavior":"prints false a"}]}