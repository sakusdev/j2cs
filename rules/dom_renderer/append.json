{"id":"dom.parentnode.append","category":"dom_renderer","summary":"Append variadic Nodes/strings, converting strings to Text nodes, with undefined return.","source":{"pattern":"$parent.append($items)","requirements":{"receiver":"Document, DocumentFragment, or Element implementing ParentNode","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.Append($parent, $items)"},"strategy":"helper","confidence":"high","semantics":{"arguments":"all evaluated left-to-right before conversion/insertion","string_conversion":"non-Node items are converted to DOMString Text nodes","return_value":"undefined","mutation":"existing nodes are moved"},"caveats":["Unlike appendChild, append accepts multiple items and strings and does not return the inserted node."],"references":["WHATWG DOM Living Standard § ParentNode.append"],"tests":[{"name":"string becomes text node","input":"const p=document.createElement('p'); p.append('x',document.createElement('b')); console.log(p.childNodes[0].nodeType,p.childNodes.length);","expected_behavior":"prints 3 2"},{"name":"returns undefined","input":"const p=document.createElement('p'); console.log(p.append('x')===undefined);","expected_behavior":"prints true"}]}