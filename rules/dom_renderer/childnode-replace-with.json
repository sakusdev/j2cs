{"id":"dom.childnode.replace-with","category":"dom_renderer","summary":"Replace a ChildNode with variadic Nodes/strings, or no-op when it has no parent.","source":{"pattern":"$node.replaceWith($items)","requirements":{"receiver":"Element or CharacterData implementing ChildNode","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.ReplaceWith($node, $items)"},"strategy":"helper","confidence":"high","semantics":{"conversion":"strings become Text nodes","return_value":"undefined","detached_receiver":"no-op","mutation":"replacement nodes moved; receiver detached when attached"},"caveats":["Argument conversion/evaluation still occurs according to Web IDL/DOM algorithms; preserve observable coercion order."],"references":["WHATWG DOM Living Standard § ChildNode.replaceWith"],"tests":[{"name":"replaces with text and node","input":"const p=document.createElement('p'),x=document.createElement('i'); p.append(x); x.replaceWith('a',document.createElement('b')); console.log(p.childNodes.length,p.firstChild.data);","expected_behavior":"prints 2 a"},{"name":"detached receiver does nothing","input":"const x=document.createElement('i'); console.log(x.replaceWith('a')===undefined,x.parentNode===null);","expected_behavior":"prints true true"}]}