{"id":"dom.document.create-element-html-known","category":"dom_renderer","summary":"Create a known built-in HTML element through the native DOM abstraction when custom-element behavior is unobservable.","source":{"pattern":"$document.createElement($localName)","requirements":{"receiver":"HTML Document","builtin_not_overridden":true,"local_name_statically_known":true,"known_builtin_html_tag":true,"custom_elements_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.CreateHtmlElement($document, $localName)"},"strategy":"helper","confidence":"high","semantics":{"name_conversion":"HTML documents ASCII-lowercase localName before creation","return_value":"new detached Element with ownerDocument","identity":"fresh node each call","invalid_name":"InvalidCharacterError DOMException"},"caveats":["Unknown/custom element names can invoke custom-element machinery and require runtime unless proven unobservable.","Qualified names belong to createElementNS semantics, not this specialization."],"references":["WHATWG DOM Living Standard § Document.createElement","WHATWG HTML Custom Elements"],"tests":[{"name":"HTML tag name lowercased","input":"const e=document.createElement('DIV'); console.log(e.localName, e.parentNode===null);","expected_behavior":"prints div true"},{"name":"fresh identity","input":"console.log(document.createElement('div')===document.createElement('div'));","expected_behavior":"prints false"}]}