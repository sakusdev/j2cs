{"id":"dom.element.has-attribute","category":"dom_renderer","summary":"Test attribute presence without confusing an empty string value with absence.","source":{"pattern":"$element.hasAttribute($name)","requirements":{"receiver":"Element","builtin_not_overridden":true}},"target":{"kind":"helper","template":"NativeDom.HasAttribute($element, JsCoercion.ToString($name))"},"strategy":"helper","confidence":"high","semantics":{"return_value":"boolean presence","name_normalization":"ASCII-lowercase for HTML namespace elements in HTML documents","value":"attribute value is not read"},"caveats":["Do not implement as getAttribute(name) != \"\" because empty-valued attributes are present."],"references":["WHATWG DOM Living Standard § Element.hasAttribute"],"tests":[{"name":"empty value is still present","input":"const e=document.createElement('div'); e.setAttribute('x',''); console.log(e.hasAttribute('x'));","expected_behavior":"prints true"},{"name":"missing is false","input":"console.log(document.createElement('div').hasAttribute('x'));","expected_behavior":"prints false"}]}