{"id":"dom.domtokenlist.toggle","category":"dom_renderer","summary":"Toggle a class token and return final presence, preserving the omitted-force distinction.","source":{"pattern":"$classList.toggle($token, $force)","requirements":{"receiver":"Element.classList DOMTokenList","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.ClassListToggle($classList, $token, $force)"},"strategy":"helper","confidence":"high","semantics":{"return_value":"final presence boolean","force_omitted":"invert presence","force_present":"Web IDL boolean conversion","validation":"invalid token throws before mutation"},"caveats":["Do not model optional force as nullable bool without separately tracking omission."],"references":["WHATWG DOM Living Standard § DOMTokenList.toggle"],"tests":[{"name":"toggle returns final presence","input":"const e=document.createElement('div'); console.log(e.classList.toggle('x'),e.classList.toggle('x'));","expected_behavior":"prints true false"},{"name":"force false removes and returns false","input":"const e=document.createElement('div'); e.className='x'; console.log(e.classList.toggle('x',0),e.className);","expected_behavior":"prints false followed by empty className"}]}