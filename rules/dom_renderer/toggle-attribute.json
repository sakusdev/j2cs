{"id":"dom.element.toggle-attribute","category":"dom_renderer","summary":"Toggle attribute presence, respecting omitted force versus explicit boolean force and returning final presence.","source":{"pattern":"$element.toggleAttribute($name, $force)","requirements":{"receiver":"Element","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"trusted_types_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.ToggleAttribute($element, JsCoercion.ToString($name), $force)"},"strategy":"helper","confidence":"high","semantics":{"force_omitted":"invert current presence","force_present":"Web IDL boolean conversion then force presence/absence","added_value":"empty string","return_value":"true iff attribute is present after call","invalid_name":"InvalidCharacterError DOMException"},"caveats":["Compiler must preserve whether the force argument was omitted; passing a default false changes semantics."],"references":["WHATWG DOM Living Standard § Element.toggleAttribute"],"tests":[{"name":"omitted force toggles","input":"const e=document.createElement('div'); console.log(e.toggleAttribute('x'),e.toggleAttribute('x'));","expected_behavior":"prints true false"},{"name":"explicit force does not toggle","input":"const e=document.createElement('div'); console.log(e.toggleAttribute('x',true),e.toggleAttribute('x',true),e.hasAttribute('x'));","expected_behavior":"prints true true true"}]}