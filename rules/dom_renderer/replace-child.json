{"id":"dom.node.replace-child","category":"dom_renderer","summary":"Replace a direct child with a node and return the removed child, preserving reparenting and hierarchy checks.","source":{"pattern":"$parent.replaceChild($newNode, $oldChild)","requirements":{"receiver_is_native_dom_node":true,"builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.ReplaceChild($parent, $newNode, $oldChild)"},"strategy":"helper","confidence":"high","semantics":{"return_value":"old child","mutation":"new node is moved from prior parent; old child becomes detached","document_fragment":"fragment children replace old child and fragment becomes empty","error":"NotFoundError/HierarchyRequestError as applicable"},"caveats":["C# collection replacement must not clone nodes or lose detached-node identity."],"references":["WHATWG DOM Living Standard § Node.replaceChild / replace"],"tests":[{"name":"returns old child","input":"const p=document.createElement('p'),a=document.createElement('i'),b=document.createElement('b'); p.append(a); console.log(p.replaceChild(b,a)===a,p.firstChild===b,a.parentNode===null);","expected_behavior":"prints true true true"},{"name":"non-child old node throws","input":"const p=document.createElement('p'); try{p.replaceChild(document.createElement('i'),document.createElement('b'))}catch(e){console.log(e.name)}","expected_behavior":"prints NotFoundError"}]}