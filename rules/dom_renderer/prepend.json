{"id":"dom.parentnode.prepend","category":"dom_renderer","summary":"Prepend variadic Nodes/strings in argument order, converting strings to Text nodes.","source":{"pattern":"$parent.prepend($items)","requirements":{"receiver":"Document, DocumentFragment, or Element implementing ParentNode","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.Prepend($parent, $items)"},"strategy":"helper","confidence":"high","semantics":{"order":"argument order preserved at beginning of child list","string_conversion":"non-Node items become Text nodes","return_value":"undefined","mutation":"existing nodes moved"},"caveats":["Do not repeatedly insert each argument at index 0; that would reverse order."],"references":["WHATWG DOM Living Standard § ParentNode.prepend"],"tests":[{"name":"preserves argument order","input":"const p=document.createElement('p'); p.append('z'); p.prepend('a','b'); console.log(p.textContent);","expected_behavior":"prints abz"},{"name":"moves existing node","input":"const p=document.createElement('p'),x=document.createElement('i'); p.append('a',x); p.prepend(x); console.log(p.firstChild===x,p.childNodes.length);","expected_behavior":"prints true 2"}]}