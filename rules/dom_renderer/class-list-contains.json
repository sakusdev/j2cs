{"id":"dom.domtokenlist.contains","category":"dom_renderer","summary":"Check exact class-token membership with DOMTokenList validation.","source":{"pattern":"$classList.contains($token)","requirements":{"receiver":"Element.classList DOMTokenList","builtin_not_overridden":true}},"target":{"kind":"helper","template":"NativeDom.ClassListContains($classList, $token)"},"strategy":"helper","confidence":"high","semantics":{"return_value":"boolean","matching":"case-sensitive token membership","validation":"empty token => SyntaxError; ASCII whitespace => InvalidCharacterError"},"caveats":["String.Contains on className is not equivalent because token boundaries matter."],"references":["WHATWG DOM Living Standard § DOMTokenList.contains"],"tests":[{"name":"case-sensitive membership","input":"const e=document.createElement('div'); e.className='A'; console.log(e.classList.contains('A'),e.classList.contains('a'));","expected_behavior":"prints true false"},{"name":"whitespace token throws","input":"const e=document.createElement('div'); try{e.classList.contains('a b')}catch(err){console.log(err.name)}","expected_behavior":"prints InvalidCharacterError"}]}