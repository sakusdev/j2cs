{"id":"dom.childnode.remove","category":"dom_renderer","summary":"Detach a ChildNode from its parent, or do nothing if it has no parent.","source":{"pattern":"$node.remove()","requirements":{"receiver":"Element or CharacterData implementing ChildNode","builtin_not_overridden":true,"mutation_observers_unobservable":true,"custom_element_reactions_unobservable":true,"shadow_slotting_unobservable":true}},"target":{"kind":"helper","template":"NativeDom.Remove($node)"},"strategy":"helper","confidence":"high","semantics":{"no_parent":"no-op","return_value":"undefined","identity":"node remains usable after detachment"},"caveats":["Do not throw NotFoundError for a detached receiver; remove() differs from parent.removeChild(child)."],"references":["WHATWG DOM Living Standard § ChildNode.remove"],"tests":[{"name":"removes attached node","input":"const x=document.createElement('i'); document.body.append(x); console.log(x.remove()===undefined,x.parentNode===null);","expected_behavior":"prints true true"},{"name":"detached remove is no-op","input":"const x=document.createElement('i'); x.remove(); console.log(x.parentNode===null);","expected_behavior":"prints true"}]}