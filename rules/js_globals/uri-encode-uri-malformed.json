{
  "id": "uri.encode-uri.malformed",
  "category": "js_globals",
  "summary": "Preserve URIError for statically recognized malformed input to encodeURI.",
  "source": {
    "pattern": "encodeURI($string)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%encodeURI%",
      "builtin_not_replaced": true,
      "argument_static_type": "String",
      "input_statically_known_malformed_for_operation": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.EncodeUri",
    "template": "JsUri.EncodeUri($string)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "unescaped": "URI reserved characters plus unescaped marks remain literal; other scalar values use uppercase UTF-8 percent escapes",
    "surrogates": "unpaired UTF-16 surrogate throws URIError",
    "error": "URIError; no lossy replacement or permissive decoder"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "malformed",
      "input": "try{encodeURI(\"\\ud800\")}catch(e){console.log(e.name)}",
      "expected_behavior": "prints URIError"
    },
    {
      "name": "error category",
      "input": "try{encodeURI(\"\\ud800\")}catch(e){console.log(e instanceof URIError)}",
      "expected_behavior": "prints true"
    }
  ]
}
