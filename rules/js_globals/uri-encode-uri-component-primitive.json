{
  "id": "uri.encode-uri-component.primitive",
  "category": "js_globals",
  "summary": "Coerce a non-String primitive with ECMAScript ToString before encodeURIComponent.",
  "source": {
    "pattern": "encodeURIComponent($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%encodeURIComponent%",
      "builtin_not_replaced": true,
      "argument_is_primitive": true,
      "argument_static_type_excludes": "String"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.EncodeUriComponentPrimitive",
    "template": "JsUri.EncodeUriComponentPrimitive($value)",
    "notes": "Reuse JsCoercion.ToStringPrimitive."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "unescaped": "only URIUnescaped set remains literal; URI reserved delimiters are percent-escaped",
    "surrogates": "unpaired UTF-16 surrogate throws URIError",
    "conversion": "ToString before URI operation",
    "symbol": "TypeError during ToString"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "number stringified",
      "input": "console.log(encodeURIComponent(123));",
      "expected_behavior": "operates on the string '123'"
    },
    {
      "name": "symbol rejected",
      "input": "try{encodeURIComponent(Symbol())}catch(e){console.log(e.name)}",
      "expected_behavior": "prints TypeError"
    }
  ]
}
