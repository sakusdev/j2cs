{
  "id": "uri.encode-uri-component.string",
  "category": "js_globals",
  "summary": "Apply ECMAScript encodeURIComponent to a valid String using its exact URI character/UTF-8 rules.",
  "source": {
    "pattern": "encodeURIComponent($string)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%encodeURIComponent%",
      "builtin_not_replaced": true,
      "argument_static_type": "String",
      "input_proven_well_formed_for_operation": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.EncodeUriComponent",
    "template": "JsUri.EncodeUriComponent($string)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "unescaped": "only URIUnescaped set remains literal; URI reserved delimiters are percent-escaped",
    "surrogates": "unpaired UTF-16 surrogate throws URIError"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "representative",
      "input": "console.log(encodeURIComponent(\"a/b?c=d\"));",
      "expected_behavior": "prints a%2Fb%3Fc%3Dd"
    },
    {
      "name": "unicode",
      "input": "console.log(encodeURIComponent('✓'));",
      "expected_behavior": "uses UTF-8 percent encoding/decoding according to ECMAScript"
    }
  ]
}
