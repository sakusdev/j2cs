{
  "id": "global.is-finite.number",
  "category": "js_globals",
  "summary": "Lower intrinsic global isFinite directly for an already-proven Number.",
  "source": {
    "pattern": "isFinite($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%isFinite%",
      "builtin_not_replaced": true,
      "argument_static_type": "Number"
    }
  },
  "target": {
    "kind": "csharp",
    "template": "double.IsFinite($value)"
  },
  "strategy": "native",
  "confidence": "high",
  "semantics": {
    "conversion": "ToNumber is identity",
    "nan": false,
    "positive_infinity": false,
    "negative_infinity": false,
    "finite_numbers": true
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "finite",
      "input": "console.log(isFinite(3.5));",
      "expected_behavior": "prints true"
    },
    {
      "name": "infinity",
      "input": "console.log(isFinite(Infinity));",
      "expected_behavior": "prints false"
    }
  ]
}
