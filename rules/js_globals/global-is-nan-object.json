{
  "id": "global.is-nan.object",
  "category": "js_globals",
  "summary": "Use runtime ToNumber when global isNaN receives an object/Proxy.",
  "source": {
    "pattern": "isNaN($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%isNaN%",
      "builtin_not_replaced": true,
      "argument_may_be_object_or_proxy": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.GlobalIsNaN",
    "template": "JsRuntime.GlobalIsNaN($value)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "conversion": "observable object ToPrimitive/ToNumber",
    "exceptions": "propagate"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "custom primitive",
      "input": "console.log(isNaN({[Symbol.toPrimitive](){return 'x'}}));",
      "expected_behavior": "prints true"
    },
    {
      "name": "throwing conversion",
      "input": "try{isNaN({valueOf(){throw 7}})}catch(e){console.log(e)}",
      "expected_behavior": "prints 7"
    }
  ]
}
