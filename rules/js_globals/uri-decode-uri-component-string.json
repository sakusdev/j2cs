{
  "id": "uri.decode-uri-component.string",
  "category": "js_globals",
  "summary": "Apply ECMAScript decodeURIComponent to a valid String using its exact URI character/UTF-8 rules.",
  "source": {
    "pattern": "decodeURIComponent($string)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%decodeURIComponent%",
      "builtin_not_replaced": true,
      "argument_static_type": "String",
      "input_proven_well_formed_for_operation": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.DecodeUriComponent",
    "template": "JsUri.DecodeUriComponent($string)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "decoding": "decode valid UTF-8 percent sequences including reserved delimiters",
    "preserve": "no URI-reserved preserve set",
    "errors": "malformed percent syntax or invalid UTF-8 scalar sequence throws URIError"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "representative",
      "input": "console.log(decodeURIComponent(\"a%2Fb%3Fc%3Dd\"));",
      "expected_behavior": "prints a/b?c=d"
    },
    {
      "name": "unicode",
      "input": "console.log(decodeURIComponent('✓'));",
      "expected_behavior": "uses UTF-8 percent encoding/decoding according to ECMAScript"
    }
  ]
}
