{
  "id": "global.is-finite.object",
  "category": "js_globals",
  "summary": "Use runtime ToNumber when global isFinite receives an object/Proxy.",
  "source": {
    "pattern": "isFinite($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%isFinite%",
      "builtin_not_replaced": true,
      "argument_may_be_object_or_proxy": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.GlobalIsFinite",
    "template": "JsRuntime.GlobalIsFinite($value)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "conversion": "ToNumber may execute Symbol.toPrimitive/valueOf/toString/getter/Proxy code",
    "exceptions": "propagate"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "valueOf",
      "input": "console.log(isFinite({valueOf(){return 4}}));",
      "expected_behavior": "prints true"
    },
    {
      "name": "conversion throws",
      "input": "try{isFinite({valueOf(){throw 'x'}})}catch(e){console.log(e)}",
      "expected_behavior": "prints x"
    }
  ]
}
