{
  "id": "globalthis.dynamic-property",
  "category": "js_globals",
  "summary": "Use realm/runtime property resolution when the writable/configurable globalThis property may have been changed.",
  "source": {
    "pattern": "globalThis",
    "requirements": {
      "identifier_resolves_to_global_property": true,
      "globalthis_property_may_be_mutated_or_redefined": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.ResolveGlobalThis",
    "template": "JsRuntime.ResolveGlobalThis($realm)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "initial_descriptor": {
      "writable": true,
      "enumerable": false,
      "configurable": true
    },
    "lookup": "ordinary global-environment/property semantics after mutation"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "reassignment observable",
      "input": "const g=globalThis; globalThis.globalThis=123; console.log(globalThis); g.globalThis=g;",
      "expected_behavior": "prints 123"
    },
    {
      "name": "configurable",
      "input": "console.log(Object.getOwnPropertyDescriptor(globalThis,'globalThis').configurable);",
      "expected_behavior": "prints true"
    }
  ]
}
