{
  "id": "global.is-finite.primitive",
  "category": "js_globals",
  "summary": "Apply canonical ToNumber to non-Number primitives before the global isFinite test.",
  "source": {
    "pattern": "isFinite($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%isFinite%",
      "builtin_not_replaced": true,
      "argument_is_primitive": true,
      "argument_static_type_excludes": "Number"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsGlobals.IsFinitePrimitive",
    "template": "JsGlobals.IsFinitePrimitive($value)",
    "notes": "Reuse JsCoercion.ToNumberPrimitive."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "conversion": "ECMAScript ToNumber",
    "null": true,
    "empty_string": true,
    "undefined": false,
    "bigint_or_symbol": "TypeError"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "string coerced",
      "input": "console.log(isFinite('3'));",
      "expected_behavior": "prints true"
    },
    {
      "name": "undefined becomes NaN",
      "input": "console.log(isFinite(undefined));",
      "expected_behavior": "prints false"
    }
  ]
}
