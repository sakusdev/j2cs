{
  "id": "uri.encode-uri.object",
  "category": "js_globals",
  "summary": "Use runtime ToString + encodeURI semantics for objects/Proxies.",
  "source": {
    "pattern": "encodeURI($value)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%encodeURI%",
      "builtin_not_replaced": true,
      "argument_may_be_object_or_proxy": true
    }
  },
  "target": {
    "kind": "runtime",
    "helper": "JsRuntime.UriEncodeUri",
    "template": "JsRuntime.UriEncodeUri($value)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "unescaped": "URI reserved characters plus unescaped marks remain literal; other scalar values use uppercase UTF-8 percent escapes",
    "surrogates": "unpaired UTF-16 surrogate throws URIError",
    "conversion": "observable object ToString",
    "exceptions": "conversion or URI errors propagate"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "custom toString",
      "input": "console.log(encodeURI({toString(){return \"https://a.example/x y?z=1#f\"}}));",
      "expected_behavior": "prints https://a.example/x%20y?z=1#f"
    },
    {
      "name": "throwing conversion",
      "input": "try{encodeURI({toString(){throw 'x'}})}catch(e){console.log(e)}",
      "expected_behavior": "prints x"
    }
  ]
}
