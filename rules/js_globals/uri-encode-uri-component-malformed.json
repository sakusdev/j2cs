{
  "id": "uri.encode-uri-component.malformed",
  "category": "js_globals",
  "summary": "Preserve URIError for statically recognized malformed input to encodeURIComponent.",
  "source": {
    "pattern": "encodeURIComponent($string)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%encodeURIComponent%",
      "builtin_not_replaced": true,
      "argument_static_type": "String",
      "input_statically_known_malformed_for_operation": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.EncodeUriComponent",
    "template": "JsUri.EncodeUriComponent($string)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "unescaped": "only URIUnescaped set remains literal; URI reserved delimiters are percent-escaped",
    "surrogates": "unpaired UTF-16 surrogate throws URIError",
    "error": "URIError; no lossy replacement or permissive decoder"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "malformed",
      "input": "try{encodeURIComponent(\"\\ud800\")}catch(e){console.log(e.name)}",
      "expected_behavior": "prints URIError"
    },
    {
      "name": "error category",
      "input": "try{encodeURIComponent(\"\\ud800\")}catch(e){console.log(e instanceof URIError)}",
      "expected_behavior": "prints true"
    }
  ]
}
