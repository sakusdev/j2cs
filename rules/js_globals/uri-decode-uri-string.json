{
  "id": "uri.decode-uri.string",
  "category": "js_globals",
  "summary": "Apply ECMAScript decodeURI to a valid String using its exact URI character/UTF-8 rules.",
  "source": {
    "pattern": "decodeURI($string)",
    "requirements": {
      "binding_resolves_to_intrinsic": "%decodeURI%",
      "builtin_not_replaced": true,
      "argument_static_type": "String",
      "input_proven_well_formed_for_operation": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsUri.DecodeUri",
    "template": "JsUri.DecodeUri($string)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "decoding": "decode valid UTF-8 percent sequences",
    "preserve": "percent escapes denoting URI reserved characters remain escaped",
    "errors": "malformed percent syntax or invalid UTF-8 scalar sequence throws URIError"
  },
  "references": [
    "https://tc39.es/ecma262/2026/multipage/global-object.html"
  ],
  "tests": [
    {
      "name": "representative",
      "input": "console.log(decodeURI(\"https://x/a%20b?x=%23\"));",
      "expected_behavior": "prints https://x/a b?x=%23"
    },
    {
      "name": "unicode",
      "input": "console.log(decodeURI('✓'));",
      "expected_behavior": "uses UTF-8 percent encoding/decoding according to ECMAScript"
    }
  ]
}
