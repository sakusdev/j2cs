{
  "id": "node.net.server.listen",
  "category": "node_net_tls_dns",
  "summary": "Start asynchronous TCP listening with listening/error event ordering.",
  "source": {
    "pattern": "$server.listen($options, $callback)",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.NodeNetServerListen($server, $options, $callback)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return": "same Server",
    "async_bind": true,
    "port_zero": "OS-assigned",
    "callback": "once listening listener"
  },
  "caveats": [
    "Bind completion and errors are observable asynchronous events."
  ],
  "references": [
    "Node.js net API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const net=require('node:net');const s=net.createServer();console.log(s.listen(0)===s);s.on('listening',()=>s.close())",
      "expected_behavior": "prints true"
    },
    {
      "name": "semantic trap",
      "input": "const net=require('node:net');console.log(net.createServer().address()===null)",
      "expected_behavior": "prints true before listening"
    }
  ]
}
