{
  "id": "node.dns.resolve-mx",
  "category": "node_net_tls_dns",
  "summary": "Resolve MX priority/exchange records.",
  "source": {
    "pattern": "dns.resolveMx($hostname, $callback)",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.NodeDnsResolveMx($hostname, $callback)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "protocol": "MX",
    "return": "{priority,exchange}[]"
  },
  "caveats": [
    "Preserve record priority rather than flattening hostnames."
  ],
  "references": [
    "Node.js dns API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "console.log(typeof require('node:dns').resolveMx)",
      "expected_behavior": "prints function"
    },
    {
      "name": "semantic trap",
      "input": "/* successful MX */",
      "expected_behavior": "each record retains priority and exchange"
    }
  ]
}
