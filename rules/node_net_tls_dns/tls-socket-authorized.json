{
  "id": "node.tls.socket.authorized",
  "category": "node_net_tls_dns",
  "summary": "Expose peer-certificate authorization boolean.",
  "source": {
    "pattern": "$socket.authorized",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeTls.GetAuthorized",
    "template": "NodeTls.GetAuthorized($socket)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return": "boolean",
    "verification": "CA/host/policy",
    "meaningful_after_handshake": true
  },
  "caveats": [
    "Connection may proceed with authorized=false when configured to allow it."
  ],
  "references": [
    "Node.js tls API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const tls=require('node:tls');console.log(typeof new tls.TLSSocket().authorized)",
      "expected_behavior": "prints boolean"
    },
    {
      "name": "semantic trap",
      "input": "/* rejectUnauthorized:false with bad cert */",
      "expected_behavior": "secureConnect can occur while authorized is false"
    }
  ]
}
