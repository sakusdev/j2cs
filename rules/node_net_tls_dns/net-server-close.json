{
  "id": "node.net.server.close",
  "category": "node_net_tls_dns",
  "summary": "Stop accepting new connections and finish close after existing connections end.",
  "source": {
    "pattern": "$server.close($callback)",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.NodeNetServerClose($server, $callback)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return": "Server",
    "new_accepts": false,
    "existing_connections": "remain",
    "close_event": "after connections end"
  },
  "caveats": [
    "Immediate disposal changes close timing."
  ],
  "references": [
    "Node.js net API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const net=require('node:net');const s=net.createServer().listen(0,()=>console.log(s.close()===s))",
      "expected_behavior": "prints true"
    },
    {
      "name": "semantic trap",
      "input": "/* close with live accepted socket */",
      "expected_behavior": "close event waits for existing connection termination"
    }
  ]
}
