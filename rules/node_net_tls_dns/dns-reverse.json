{
  "id": "node.dns.reverse",
  "category": "node_net_tls_dns",
  "summary": "Reverse-resolve an IP via PTR reverse-zone lookup.",
  "source": {
    "pattern": "dns.reverse($ip, $callback)",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.NodeDnsReverse($ip, $callback)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "input": "IP literal",
    "protocol": "PTR reverse zone",
    "return": "hostname[]"
  },
  "caveats": [
    "Not equivalent to lookupService."
  ],
  "references": [
    "Node.js dns API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "console.log(typeof require('node:dns').reverse)",
      "expected_behavior": "prints function"
    },
    {
      "name": "semantic trap",
      "input": "require('node:dns').reverse('not-ip',e=>console.log(!!e))",
      "expected_behavior": "prints true"
    }
  ]
}
