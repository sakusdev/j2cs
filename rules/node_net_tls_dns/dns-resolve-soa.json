{
  "id": "node.dns.resolve-soa",
  "category": "node_net_tls_dns",
  "summary": "Resolve one SOA metadata object.",
  "source": {
    "pattern": "dns.resolveSoa($hostname, $callback)",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "JsRuntime.NodeDnsResolveSoa($hostname, $callback)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "protocol": "SOA",
    "fields": [
      "nsname",
      "hostmaster",
      "serial",
      "refresh",
      "retry",
      "expire",
      "minttl"
    ],
    "single_object": true
  },
  "caveats": [
    "SOA returns a single object, not the same array shape as many record APIs."
  ],
  "references": [
    "Node.js dns API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "console.log(typeof require('node:dns').resolveSoa)",
      "expected_behavior": "prints function"
    },
    {
      "name": "semantic trap",
      "input": "/* successful SOA */",
      "expected_behavior": "callback receives one SOA object"
    }
  ]
}
