{
  "id": "node.tls.socket.is-session-reused",
  "category": "node_net_tls_dns",
  "summary": "Report whether current handshake reused a TLS session.",
  "source": {
    "pattern": "$socket.isSessionReused()",
    "requirements": {
      "builtin_node_member_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeTls.IsSessionReused",
    "template": "NodeTls.IsSessionReused($socket)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return": "boolean",
    "handshake_dependent": true
  },
  "caveats": [
    "Fresh and resumed handshakes are observably different."
  ],
  "references": [
    "Node.js tls API"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "const tls=require('node:tls');console.log(typeof new tls.TLSSocket().isSessionReused)",
      "expected_behavior": "prints function"
    },
    {
      "name": "semantic trap",
      "input": "/* resumed handshake */",
      "expected_behavior": "returns true only when provider reports session reuse"
    }
  ]
}
