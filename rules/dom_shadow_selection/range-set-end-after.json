{
  "id": "dom.range.set-end-after",
  "category": "dom_shadow_selection",
  "summary": "Set end immediately after node.",
  "source": {
    "pattern": "$range.setEndAfter($node)",
    "requirements": {
      "builtin_webidl_member_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NativeDom.RangeSetEndAfter",
    "template": "NativeDom.RangeSetEndAfter($range, $node)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "parent_required": true,
    "boundary": "parent,index(node)+1"
  },
  "caveats": [
    "Detached node is invalid."
  ],
  "references": [
    "WHATWG DOM Standard"
  ],
  "tests": [
    {
      "name": "normal",
      "input": "/* parent with child */ r.setEndAfter(child)",
      "expected_behavior": "end offset is child index + 1"
    },
    {
      "name": "semantic trap",
      "input": "/* detached */",
      "expected_behavior": "throws InvalidNodeTypeError"
    }
  ]
}
