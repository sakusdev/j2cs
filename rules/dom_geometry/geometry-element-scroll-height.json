{
  "id": "dom.geometry.element.scroll-height",
  "category": "dom_geometry",
  "summary": "Return height required to contain scrollable overflow/content.",
  "source": {
    "pattern": "$element.scrollHeight",
    "requirements": {
      "dom_environment": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "NativeDomGeometry.GetScrollHeight($element)",
    "notes": "Layout-derived values delegate to the renderer/layout runtime; this rule owns the DOM/CSSOM View API contract, not CSS layout computation."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "integer": "CSS pixel integer",
    "minimum": "at least clientHeight under ordinary geometry",
    "layout": "overflow contributes"
  },
  "caveats": [],
  "references": [
    "CSSOM View Module Level 1",
    "Geometry Interfaces Module Level 1"
  ],
  "tests": [
    {
      "name": "number",
      "input": "console.log(typeof el.scrollHeight);",
      "expected_behavior": "prints number"
    },
    {
      "name": "overflow",
      "input": "/* element with tall overflowing child */",
      "expected_behavior": "scrollHeight can exceed clientHeight"
    }
  ]
}
