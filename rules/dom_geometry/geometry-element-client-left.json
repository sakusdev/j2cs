{
  "id": "dom.geometry.element.client-left",
  "category": "dom_geometry",
  "summary": "Return clientLeft derived from border/layout geometry including direction/scrollbar effects.",
  "source": {
    "pattern": "$element.clientLeft",
    "requirements": {
      "dom_environment": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "NativeDomGeometry.GetClientLeft($element)",
    "notes": "Layout-derived values delegate to the renderer/layout runtime; this rule owns the DOM/CSSOM View API contract, not CSS layout computation."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "integer": "CSS pixel integer",
    "layout": "renderer-owned",
    "direction": "scrollbar placement/writing direction may matter"
  },
  "caveats": [],
  "references": [
    "CSSOM View Module Level 1",
    "Geometry Interfaces Module Level 1"
  ],
  "tests": [
    {
      "name": "number",
      "input": "console.log(typeof el.clientLeft);",
      "expected_behavior": "prints number"
    },
    {
      "name": "not offsetLeft",
      "input": "console.log(el.clientLeft===el.offsetLeft);",
      "expected_behavior": "not generally guaranteed"
    }
  ]
}
