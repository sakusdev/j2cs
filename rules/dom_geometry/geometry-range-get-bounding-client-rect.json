{
  "id": "dom.geometry.range.get-bounding-client-rect",
  "category": "dom_geometry",
  "summary": "Return bounding rectangle enclosing Range client rects.",
  "source": {
    "pattern": "$range.getBoundingClientRect()",
    "requirements": {
      "dom_environment": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "NativeDomGeometry.GetRangeBoundingClientRect($range)",
    "notes": "Layout-derived values delegate to the renderer/layout runtime; this rule owns the DOM/CSSOM View API contract, not CSS layout computation."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "source": "Range client rects",
    "return_value": "DOMRect snapshot",
    "layout": "renderer-derived"
  },
  "caveats": [],
  "references": [
    "CSSOM View Module Level 1",
    "Geometry Interfaces Module Level 1"
  ],
  "tests": [
    {
      "name": "rect",
      "input": "const r=range.getBoundingClientRect();console.log(typeof r.width);",
      "expected_behavior": "prints number"
    },
    {
      "name": "collapsed range",
      "input": "const r=range.getBoundingClientRect();",
      "expected_behavior": "may be zero-sized depending caret/layout position"
    }
  ]
}
