{
  "id": "node.fs.write-stream.bytes-written",
  "category": "node_fs_watch_streams",
  "summary": "Report bytes successfully written by stream.",
  "source": {
    "pattern": "stream.bytesWritten",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.WriteStreamBytesWritten",
    "template": "NodeFs.WriteStreamBytesWritten(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Does not include queued-but-not-written bytes."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "stream.bytesWritten",
      "expected_behavior": "Report bytes successfully written by stream."
    },
    {
      "name": "semantic trap",
      "input": "stream.bytesWritten",
      "expected_behavior": "Does not include queued-but-not-written bytes."
    }
  ]
}
