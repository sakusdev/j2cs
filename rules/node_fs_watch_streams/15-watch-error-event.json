{
  "id": "node.fs.watch.error-event",
  "category": "node_fs_watch_streams",
  "summary": "Expose host watch errors.",
  "source": {
    "pattern": "watcher.on('error',listener)",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.FSWatcherError",
    "template": "NodeFs.FSWatcherError(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Error objects/codes must retain Node fs error semantics."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "watcher.on('error',listener)",
      "expected_behavior": "Expose host watch errors."
    },
    {
      "name": "semantic trap",
      "input": "watcher.on('error',listener)",
      "expected_behavior": "Error objects/codes must retain Node fs error semantics."
    }
  ]
}
