{
  "id": "node.fs.watch.inode-lifetime",
  "category": "node_fs_watch_streams",
  "summary": "Preserve inode-bound behavior on Linux/macOS.",
  "source": {
    "pattern": "fs.watch(path,listener)",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.Watch",
    "template": "NodeFs.Watch(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Delete/recreate may keep watching old inode and miss new inode changes."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "fs.watch(path,listener)",
      "expected_behavior": "Preserve inode-bound behavior on Linux/macOS."
    },
    {
      "name": "semantic trap",
      "input": "fs.watch(path,listener)",
      "expected_behavior": "Delete/recreate may keep watching old inode and miss new inode changes."
    }
  ]
}
