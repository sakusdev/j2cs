{
  "id": "node.fs.opendir.encoding",
  "category": "node_fs_watch_streams",
  "summary": "Preserve Dirent name encoding.",
  "source": {
    "pattern": "opendir(path,{encoding})",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.OpenDir",
    "template": "NodeFs.OpenDir(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "encoding:'buffer' produces Buffer names."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "opendir(path,{encoding})",
      "expected_behavior": "Preserve Dirent name encoding."
    },
    {
      "name": "semantic trap",
      "input": "opendir(path,{encoding})",
      "expected_behavior": "encoding:'buffer' produces Buffer names."
    }
  ]
}
