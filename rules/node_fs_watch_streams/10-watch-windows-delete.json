{
  "id": "node.fs.watch.windows-delete",
  "category": "node_fs_watch_streams",
  "summary": "Preserve Windows watcher move/delete behavior.",
  "source": {
    "pattern": "fs.watch(dir,listener)",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.Watch",
    "template": "NodeFs.Watch(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Moved directory can stop events; deletion can surface EPERM."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "fs.watch(dir,listener)",
      "expected_behavior": "Preserve Windows watcher move/delete behavior."
    },
    {
      "name": "semantic trap",
      "input": "fs.watch(dir,listener)",
      "expected_behavior": "Moved directory can stop events; deletion can surface EPERM."
    }
  ]
}
