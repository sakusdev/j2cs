{
  "id": "node.fs.watch.filename-nullable",
  "category": "node_fs_watch_streams",
  "summary": "Allow filename to be null/unavailable.",
  "source": {
    "pattern": "watch(path,(type,filename)=>{})",
    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.Watch",
    "template": "NodeFs.Watch(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Even supported platforms do not guarantee a filename."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "watch(path,(type,filename)=>{})",
      "expected_behavior": "Allow filename to be null/unavailable."
    },
    {
      "name": "semantic trap",
      "input": "watch(path,(type,filename)=>{})",
      "expected_behavior": "Even supported platforms do not guarantee a filename."
    }
  ]
}
