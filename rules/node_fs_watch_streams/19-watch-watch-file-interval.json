    "requirements": {
      "node_builtin_binding": true,
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "NodeFs.WatchFile",
    "template": "NodeFs.WatchFile(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "node_host_semantics": true,
    "events": "reuse EVENTS_STREAMS where generic",
    "path_errors": "reuse NODE_FS core"
  },
  "caveats": [
    "Interval is milliseconds and is not debounce timing."
  ],
  "references": [
    "https://nodejs.org/api/fs.html"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "fs.watchFile(path,{interval:n},listener)",
      "expected_behavior": "Preserve polling interval."
    },
    {
      "name": "semantic trap",
      "input": "fs.watchFile(path,{interval:n},listener)",
      "expected_behavior": "Interval is milliseconds and is not debounce timing."
    }
  ]
