{
  "id": "electron.webcontents.navigation.is-loading-main-frame",
  "category": "electron_webcontents_advanced",
  "summary": "Report loading state specifically for the main frame.",
  "source": {
    "pattern": "$contents.isLoadingMainFrame()",
    "requirements": {
      "receiver": "Electron WebContents",
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "notes": "Preserve Electron WebContents/Chromium renderer semantics through the ElectronCompat host boundary; do not replace navigation, rendering, printing, or DevTools with ordinary .NET calls.",
    "template": "ElectronCompat.WebContentsIsLoadingMainFrame($contents)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return_value": "boolean",
    "scope": "main frame only"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/web-contents"
  ],
  "tests": [
    {
      "name": "boolean",
      "input": "console.log(typeof wc.isLoadingMainFrame())",
      "expected_behavior": "prints boolean"
    },
    {
      "name": "not alias",
      "input": "console.log(wc.isLoading()===wc.isLoadingMainFrame())",
      "expected_behavior": "not guaranteed"
    }
  ]
}
