{
  "id": "electron.webcontents.advanced.devtools-is-opened",
  "category": "electron_webcontents_advanced",
  "summary": "Report whether DevTools is currently opened.",
  "source": {
    "pattern": "$contents.isDevToolsOpened()",
    "requirements": {
      "receiver": "Electron WebContents",
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "notes": "Preserve Electron WebContents/Chromium renderer semantics through the ElectronCompat host boundary; do not replace navigation, rendering, printing, or DevTools with ordinary .NET calls.",
    "template": "ElectronCompat.IsDevToolsOpened($contents)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "return_value": "boolean",
    "state": "host DevTools lifecycle"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/web-contents"
  ],
  "tests": [
    {
      "name": "boolean",
      "input": "console.log(typeof wc.isDevToolsOpened())",
      "expected_behavior": "prints boolean"
    },
    {
      "name": "state changes",
      "input": "wc.openDevTools(); /* later */ console.log(wc.isDevToolsOpened())",
      "expected_behavior": "can become true after DevTools opens"
    }
  ]
}
