{
  "id": "electron.webcontents.navigation.event-did-redirect-navigation",
  "category": "electron_webcontents_advanced",
  "summary": "Observe server-side redirect after it occurs; event is not cancellable.",
  "source": {
    "pattern": "$contents.on('did-redirect-navigation',$listener)",
    "requirements": {
      "receiver": "Electron WebContents",
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "runtime",
    "notes": "Preserve Electron WebContents/Chromium renderer semantics through the ElectronCompat host boundary; do not replace navigation, rendering, printing, or DevTools with ordinary .NET calls.",
    "template": "ElectronCompat.OnDidRedirectNavigation($contents,$listener)"
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "trigger": "after server redirect",
    "cancellable": false,
    "relationship": "use will-redirect for prevention"
  },
  "caveats": [],
  "references": [
    "https://www.electronjs.org/docs/latest/api/web-contents"
  ],
  "tests": [
    {
      "name": "observe",
      "input": "wc.on('did-redirect-navigation',()=>console.log('r'))",
      "expected_behavior": "prints r after a followed redirect"
    },
    {
      "name": "too late to cancel",
      "input": "wc.on('did-redirect-navigation',e=>e.preventDefault?.())",
      "expected_behavior": "does not provide redirect-prevention semantics"
    }
  ]
}
