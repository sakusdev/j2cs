{
  "id": "binary.arraybuffer.resizable-metadata",
  "category": "binary",
  "summary": "Read resizable and maxByteLength metadata.",
  "source": {
    "pattern": "$buffer.resizable / $buffer.maxByteLength",
    "requirements": {
      "receiver": "builtin ArrayBuffer"
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsBinary.ArrayBufferMetadata",
    "template": "JsBinary.ArrayBufferMetadata($buffer)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "resizable": "true iff [[ArrayBufferMaxByteLength]] exists",
    "maxByteLength": "current max for resizable; byteLength for fixed"
  },
  "tests": [
    {
      "name": "fixed metadata",
      "input": "const b=new ArrayBuffer(4); console.log(b.resizable,b.maxByteLength);",
      "expected_behavior": "prints false 4"
    },
    {
      "name": "resizable metadata",
      "input": "const b=new ArrayBuffer(4,{maxByteLength:9}); console.log(b.resizable,b.maxByteLength);",
      "expected_behavior": "prints true 9"
    }
  ],
  "references": [
    "ECMAScript 2026 binary data semantics"
  ]
}
