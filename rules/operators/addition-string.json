{"id":"operators.addition.string","category":"operators","summary":"Use native string concatenation only when both operands are proven primitive JavaScript Strings.","source":{"pattern":"$left + $right","requirements":{"left_type":"String","right_type":"String","operands_non_null_primitive_strings":true}},"target":{"kind":"csharp","template":"string.Concat($left, $right)","notes":"For two primitive strings, JavaScript + concatenates their UTF-16 code-unit sequences; string.Concat preserves that behavior."},"strategy":"native","confidence":"high","semantics":{"coercion":"none under this rule","result_type":"String","evaluation_order":"left then right","string_encoding":"UTF-16 code units"},"caveats":["Do not use if either operand may require ToPrimitive/ToString or may be represented by C# null."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html"],"tests":[{"name":"normal string concatenation","input":"console.log('ab' + 'cd');","expected_csharp":"Console.WriteLine(string.Concat(\"ab\", \"cd\"));","expected_behavior":"prints abcd"},{"name":"edge surrogate code units preserved","input":"console.log(('\\ud83d' + '\\ude00').length);","expected_csharp":"Console.WriteLine(string.Concat(\"\\ud83d\", \"\\ude00\").Length);","expected_behavior":"prints 2"}]}
