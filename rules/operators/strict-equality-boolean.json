{"id":"operators.strict-equality.boolean","category":"operators","summary":"Use native bool equality for two proven JavaScript Booleans.","source":{"pattern":"$left === $right","requirements":{"left_type":"Boolean","right_type":"Boolean"}},"target":{"kind":"csharp","template":"($left == $right)"},"strategy":"native","confidence":"high","semantics":{"coercion":"none","result_type":"Boolean"},"caveats":["Do not broaden this rule to mixed primitive types; JavaScript === never coerces."],"references":["https://tc39.es/ecma262/2026/multipage/abstract-operations.html"],"tests":[{"name":"normal boolean equality","input":"console.log(true === true);","expected_csharp":"Console.WriteLine(true == true);","expected_behavior":"prints true"},{"name":"edge boolean values differ","input":"console.log(true === false);","expected_csharp":"Console.WriteLine(true == false);","expected_behavior":"prints false"}]}
