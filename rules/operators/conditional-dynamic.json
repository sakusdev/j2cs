{"id":"operators.conditional.dynamic","category":"operators","summary":"Lower ?: using JavaScript ToBoolean when the test is not statically Boolean.","source":{"pattern":"$test ? $consequent : $alternate","requirements":{"test_may_be_non_boolean":true}},"target":{"kind":"helper","template":"(JsValue.IsTruthy($test) ? $consequent : $alternate)","helper":"JsValue.IsTruthy","notes":"Only the selected branch is evaluated; the selected branch value is returned without Boolean coercion."},"strategy":"helper","confidence":"high","semantics":{"test_coercion":"ToBoolean","short_circuit_branches":true,"result":"selected branch value"},"caveats":["Ensure C# common-type inference does not coerce branch values in a way that loses JavaScript type identity; a JsValue representation may be required."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html","https://tc39.es/ecma262/2026/multipage/abstract-operations.html"],"tests":[{"name":"normal truthy test","input":"console.log('yes' ? 1 : 2);","expected_csharp":"Console.WriteLine(JsValue.IsTruthy(\"yes\") ? JsValue.From(1d) : JsValue.From(2d));","expected_behavior":"prints 1"},{"name":"edge unselected branch skipped","input":"console.log(0 ? (()=>{throw 1})() : 'ok');","expected_behavior":"prints ok without throwing"}]}
