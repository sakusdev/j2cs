{"id":"operators.greater-than.number","category":"operators","summary":"Use native double > when both operands are proven JavaScript Numbers.","source":{"pattern":"$left > $right","requirements":{"left_type":"Number","right_type":"Number","no_to_primitive_required":true}},"target":{"kind":"csharp","template":"($left > $right)","notes":"For already-numeric doubles, C# relational comparison matches JavaScript Number comparison, including unordered NaN producing false."},"strategy":"native","confidence":"high","semantics":{"coercion":"none under this rule","result_type":"Boolean","evaluation_order":"left then right","nan_comparison":"false"},"caveats":["Do not use for Strings, BigInts, mixed BigInt/Number, or Objects requiring ToPrimitive."],"references":["https://tc39.es/ecma262/2026/multipage/abstract-operations.html","https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html"],"tests":[{"name":"normal greater-than","input":"console.log(2 > 3);","expected_csharp":"Console.WriteLine(2d > 3d);","expected_behavior":"prints false"},{"name":"edge NaN greater-than","input":"console.log(NaN > 3);","expected_csharp":"Console.WriteLine(double.NaN > 3d);","expected_behavior":"prints false"}]}
