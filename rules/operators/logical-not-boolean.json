{"id":"operators.logical-not.boolean","category":"operators","summary":"Use native ! when the operand is proven JavaScript Boolean.","source":{"pattern":"!$value","requirements":{"operand_type":"Boolean"}},"target":{"kind":"csharp","template":"(!$value)"},"strategy":"native","confidence":"high","semantics":{"coercion":"none","result_type":"Boolean"},"caveats":["For non-Boolean values JavaScript applies ToBoolean; use the dynamic logical-not rule instead."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html"],"tests":[{"name":"normal boolean not","input":"console.log(!true);","expected_csharp":"Console.WriteLine(!true);","expected_behavior":"prints false"},{"name":"edge false negation","input":"console.log(!false);","expected_csharp":"Console.WriteLine(!false);","expected_behavior":"prints true"}]}
