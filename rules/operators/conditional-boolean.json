{"id":"operators.conditional.boolean","category":"operators","summary":"Use the native C# conditional operator when the test is proven JavaScript Boolean.","source":{"pattern":"$test ? $consequent : $alternate","requirements":{"test_type":"Boolean"}},"target":{"kind":"csharp","template":"($test ? $consequent : $alternate)"},"strategy":"native","confidence":"high","semantics":{"test_coercion":"none","branch_evaluation":"only selected branch is evaluated","result":"selected branch value"},"caveats":["C# branch typing/conversion must not erase distinctions required by the JavaScript value representation."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html"],"tests":[{"name":"normal true branch","input":"console.log(true ? 'a' : 'b');","expected_csharp":"Console.WriteLine(true ? \"a\" : \"b\");","expected_behavior":"prints a"},{"name":"edge unselected branch not evaluated","input":"console.log(false ? (()=>{throw 1})() : 7);","expected_behavior":"prints 7 and does not throw"}]}
