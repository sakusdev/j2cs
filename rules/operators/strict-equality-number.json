{"id":"operators.strict-equality.number","category":"operators","summary":"Use native double equality for two proven JavaScript Numbers.","source":{"pattern":"$left === $right","requirements":{"left_type":"Number","right_type":"Number"}},"target":{"kind":"csharp","template":"($left == $right)","notes":"For doubles, C# == matches JavaScript Number strict equality: NaN is unequal to everything and +0 equals -0."},"strategy":"native","confidence":"high","semantics":{"coercion":"none","result_type":"Boolean","nan_equals_nan":false,"positive_zero_equals_negative_zero":true},"caveats":["This does not implement Object.is, which treats NaN and signed zero differently."],"references":["https://tc39.es/ecma262/2026/multipage/abstract-operations.html","https://tc39.es/ecma262/2026/multipage/ecmascript-data-types-and-values.html"],"tests":[{"name":"normal equal numbers","input":"console.log(3 === 3);","expected_csharp":"Console.WriteLine(3d == 3d);","expected_behavior":"prints true"},{"name":"edge NaN and signed zero","input":"console.log(NaN === NaN, 0 === -0);","expected_behavior":"prints false true"}]}
