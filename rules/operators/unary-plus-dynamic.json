{"id":"operators.unary-plus.dynamic","category":"operators","summary":"Lower unary + through JavaScript ToNumber semantics.","source":{"pattern":"+$value","requirements":{"operand_may_require_coercion":true}},"target":{"kind":"helper","template":"JsValue.ToNumber($value)","helper":"JsValue.ToNumber","notes":"Unary + uses ToNumber, not ToNumeric; BigInt and Symbol therefore throw TypeError."},"strategy":"helper","confidence":"high","semantics":{"result_type":"Number","coercion":"ToNumber","mutation":false},"caveats":["Object conversion can invoke user code.","Do not use Convert.ToDouble: JavaScript parsing/coercion rules differ."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html","https://tc39.es/ecma262/2026/multipage/abstract-operations.html"],"tests":[{"name":"normal string conversion","input":"console.log(+' 42 ');","expected_csharp":"Console.WriteLine(JsValue.ToNumber(\" 42 \"));","expected_behavior":"prints 42"},{"name":"edge bigint throws","input":"try { console.log(+1n); } catch (e) { console.log(e.name); }","expected_behavior":"prints TypeError"}]}
