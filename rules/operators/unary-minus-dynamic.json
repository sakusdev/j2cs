{"id":"operators.unary-minus.dynamic","category":"operators","summary":"Lower unary - through ToNumeric when the operand is not statically a Number.","source":{"pattern":"-$value","requirements":{"operand_may_require_coercion_or_bigint":true}},"target":{"kind":"helper","template":"JsOperators.Negate($value)","helper":"JsOperators.Negate","notes":"Apply ToNumeric; negate Number with signed-zero preservation or BigInt arithmetically."},"strategy":"helper","confidence":"high","semantics":{"coercion":"ToNumeric","result_type":"Number or BigInt"},"caveats":["Symbol throws TypeError; object coercion may execute user code."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html","https://tc39.es/ecma262/2026/multipage/abstract-operations.html"],"tests":[{"name":"normal bigint negation","input":"console.log((-5n).toString());","expected_csharp":"Console.WriteLine(JsOperators.Negate(JsBigInt.FromInt64(5)));","expected_behavior":"prints -5"},{"name":"edge object coercion","input":"const x={valueOf(){console.log('coerce');return 2}}; console.log(-x);","expected_behavior":"prints coerce then -2"}]}
