{"id":"operators.unary-minus.number","category":"operators","summary":"Use native unary minus when the operand is already a JavaScript Number.","source":{"pattern":"-$value","requirements":{"operand_type":"Number","no_to_numeric_required":true}},"target":{"kind":"csharp","template":"(-$value)"},"strategy":"native","confidence":"high","semantics":{"coercion":"none under this rule","result_type":"Number","signed_zero":"negating +0 yields -0 and vice versa"},"caveats":["Do not use when BigInt or coercion is possible."],"references":["https://tc39.es/ecma262/2026/multipage/ecmascript-language-expressions.html","https://tc39.es/ecma262/2026/multipage/ecmascript-data-types-and-values.html"],"tests":[{"name":"normal unary minus","input":"console.log(-5);","expected_csharp":"Console.WriteLine(-5d);","expected_behavior":"prints -5"},{"name":"edge signed zero","input":"console.log(Object.is(-0, -0), Object.is(-(-0), 0));","expected_behavior":"prints true true"}]}
