{
  "id": "electron.webrequest.on-completed",
  "category": "electron.webrequest",
  "summary": "Register the onCompleted Session network interception stage.",
  "source": {
    "pattern": "$webRequest.onCompleted($filter?, $listener)",
    "requirements": {
      "electron_binding_proven": true,
      "builtin_not_overridden": true,
      "main_process": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "ElectronCompat.WebRequest.onCompleted",
    "template": "ElectronCompat.WebRequest.onCompleted(/* lowered operands */)"
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "normal": "when a request completes",
    "edge": "only the last listener registered for this event is used; null unsubscribes"
  },
  "caveats": [
    "Filters are URL-pattern based and listener replacement is per WebRequest event."
  ],
  "references": [
    "https://www.electronjs.org/docs/latest/api/web-request"
  ],
  "tests": [
    {
      "name": "normal behavior",
      "input": "session.defaultSession.webRequest.onCompleted({urls:['https://*/*']},()=>{})",
      "expected_behavior": "when a request completes"
    },
    {
      "name": "edge semantics",
      "input": "session.defaultSession.webRequest.onCompleted(null)",
      "expected_behavior": "only the last listener registered for this event is used; null unsubscribes"
    }
  ]
}
