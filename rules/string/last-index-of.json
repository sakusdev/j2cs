{
  "id": "string.prototype.lastindexof",
  "category": "string",
  "summary": "Lower lastIndexOf with JavaScript coercion, clamping, and UTF-16 ordinal matching.",
  "source": {
    "pattern": "$string.lastIndexOf($search, $position)",
    "requirements": {
      "receiver_inferred_as": "builtin String primitive",
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsString.LastIndexOf",
    "template": "JsString.LastIndexOf($string, $search, $position)",
    "notes": "Must apply JavaScript coercion/clamping and ordinal UTF-16 matching; do not use culture-sensitive .NET defaults."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "search": "code-unit exact ordinal substring",
    "position": "ToNumber; NaN behaves as +Infinity, then ToIntegerOrInfinity/clamp",
    "return_value": "greatest index or -1"
  },
  "caveats": [
    "C# string search overloads can be culture-sensitive unless StringComparison.Ordinal is selected."
  ],
  "references": [
    "https://tc39.es/ecma262/#sec-string-objects"
  ],
  "tests": [
    {
      "name": "basic match",
      "input": "console.log(\"abcabc\".lastIndexOf(\"bc\"));",
      "expected_csharp": "Console.WriteLine(JsString.LastIndexOf(\"abcabc\", \"bc\", JsUndefined.Value));",
      "expected_behavior": "matches according to JavaScript semantics"
    },
    {
      "name": "edge position",
      "input": "console.log(\"ababa\".lastIndexOf(\"ba\", NaN));",
      "expected_csharp": "Console.WriteLine(JsString.LastIndexOf(\"ababa\", \"ba\", double.NaN));",
      "expected_behavior": "prints 3"
    }
  ]
}
