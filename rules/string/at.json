{
  "id": "string.prototype.at",
  "category": "string",
  "summary": "Lower string.prototype.at with exact JavaScript index and UTF-16 semantics.",
  "source": {
    "pattern": "$string.at($index)",
    "requirements": {
      "receiver_inferred_as": "builtin String primitive",
      "builtin_not_overridden": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsString.At",
    "template": "JsString.At($string, $index)",
    "notes": "Use ToIntegerOrInfinity; negative indices are relative to UTF-16 length; out of range returns undefined."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "index": "ToIntegerOrInfinity",
    "return_value": "one UTF-16 code-unit string or undefined",
    "encoding": "does not return a whole Unicode code point"
  },
  "caveats": [],
  "references": [
    "https://tc39.es/ecma262/#sec-string-objects"
  ],
  "tests": [
    {
      "name": "positive index",
      "input": "console.log(\"abc\".at(1));",
      "expected_csharp": "Console.WriteLine(JsString.At(\"abc\", 1d));",
      "expected_behavior": "prints b"
    },
    {
      "name": "negative index",
      "input": "console.log(\"abc\".at(-1));",
      "expected_csharp": "Console.WriteLine(JsString.At(\"abc\", -1d));",
      "expected_behavior": "prints c"
    }
  ]
}
