{
  "id": "string.constructor.call",
  "category": "string",
  "summary": "Convert a JavaScript value with the semantics of calling String as a function.",
  "source": {
    "pattern": "String($value)",
    "requirements": {
      "callee_resolved_as": "builtin String constructor",
      "called_without_new": true
    }
  },
  "target": {
    "kind": "helper",
    "helper": "JsString.ToStringFunction",
    "template": "JsString.ToStringFunction($value)",
    "notes": "Implements String called as a function, including no-argument empty string and the special non-throwing Symbol descriptive-string case."
  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "return_value": "primitive string",
    "mutation": false,
    "coercion": "String function semantics; differs from abstract ToString for Symbol"
  },
  "caveats": [
    "String(Symbol(\"x\")) returns a descriptive string rather than throwing as ordinary ToString(Symbol) would."
  ],
  "references": [
    "https://tc39.es/ecma262/#sec-string-objects"
  ],
  "tests": [
    {
      "name": "number conversion",
      "input": "console.log(String(12.5));",
      "expected_csharp": "Console.WriteLine(JsString.ToStringFunction(12.5d));",
      "expected_behavior": "prints 12.5"
    },
    {
      "name": "no argument is empty string",
      "input": "console.log(String() === \"\");",
      "expected_csharp": "Console.WriteLine(JsString.ToStringFunction(JsMissing.Value) == \"\");",
      "expected_behavior": "prints true"
    }
  ]
}
