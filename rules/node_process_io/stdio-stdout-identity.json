  },
  "strategy": "helper",
  "confidence": "high",
  "semantics": {
    "identity": "stable",
    "fd": "standard output",
    "stream": "Writable or net.Socket/Duplex depending host"
  },
  "caveats": [],
  "references": [
    "Node.js process documentation",
    "Node.js stream/EventEmitter documentation"
