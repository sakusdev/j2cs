{
  "id": "node.process.signal.kill-zero",
  "category": "node_process_io",
  "summary": "Support signal 0 as existence/permission check.",
  "source": {
    "pattern": "process.kill($pid,0)",
    "requirements": {
      "node_process_binding": true
    }
  },
  "target": {
