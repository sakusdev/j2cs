{
  "id": "node.process.stdio.stderr-host-kind",
  "category": "node_process_io",
  "summary": "Select stderr stream shape from underlying host descriptor.",
  "source": {
    "pattern": "process.stderr",
    "requirements": {
      "node_process_binding": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "NodeProcessHost.CreateStderr()",
    "notes": "Reuse EVENTS_STREAMS for EventEmitter/stream mechanics and NODE_CORE for existing process basics/exit semantics."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "file": "Writable stream",
    "tty_or_pipe": "net.Socket/Duplex where applicable",
    "observable": "host connection changes behavior"
  },
  "caveats": [],
  "references": [
    "Node.js process documentation",
    "Node.js stream/EventEmitter documentation"
  ],
  "tests": [
    {
      "name": "write exists",
      "input": "console.log(typeof process.stderr.write);",
      "expected_behavior": "prints function"
    },
    {
      "name": "host-dependent tty",
      "input": "console.log(Boolean(process.stderr.isTTY));",
      "expected_behavior": "depends on stderr attachment"
    }
  ]
}
