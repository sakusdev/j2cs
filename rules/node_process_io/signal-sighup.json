{
  "id": "node.process.signal.sighup",
  "category": "node_process_io",
  "summary": "Model SIGHUP with Windows forced-termination caveat.",
  "source": {
    "pattern": "process.on('SIGHUP',$listener)",
    "requirements": {
      "node_process_binding": true
    }
  },
  "target": {
    "kind": "runtime",
    "template": "NodeProcessHost.OnSignal(\"SIGHUP\",$listener)",
    "notes": "Reuse EVENTS_STREAMS for EventEmitter/stream mechanics and NODE_CORE for existing process basics/exit semantics."
  },
  "strategy": "runtime",
  "confidence": "high",
  "semantics": {
    "posix": "default termination removable by listener",
    "windows": "listener may run but OS terminates later per Node docs"
  },
  "caveats": [],
  "references": [
    "Node.js process documentation",
    "Node.js stream/EventEmitter documentation"
  ],
  "tests": [
    {
      "name": "register",
      "input": "const f=()=>{};process.on('SIGHUP',f);process.off('SIGHUP',f);console.log('ok');",
      "expected_behavior": "prints ok where supported"
    },
    {
      "name": "platform",
      "input": "console.log(process.platform);",
      "expected_behavior": "Windows/POSIX differ"
    }
  ]
}
